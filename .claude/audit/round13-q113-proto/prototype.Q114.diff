@@ -53,6 +53,13 @@
 -- functions into the shared error namespace itself.
 -- Typed against the shared contract (`H-259`).
 function StoreBind.register(dispatch: QuadTypes.Dispatch, module: any)
+	-- [round13 Q114 (a) prototype] hand-off from an outer StoreBind observer to the StoreBind
+	-- process it recurses into (`State<State<T>>`): the outer State whose CURRENT value must be
+	-- the inner one. Four upvalues, no object field; set around the recursive call, consumed
+	-- (matched on inst/k/index, then cleared) at the inner process's entry. A throw between set
+	-- and consume leaves a stale hand-off that only a process at the SAME (inst, k, index) could
+	-- pick up — the same slot, whose next outer fire overwrites it first.
+	local hoInst: any, hoK: any, hoIndex: number, hoParent: any = nil, nil, 0, nil
 	dispatch.addHandler({
 		name = "StoreBind",
 		isHandlable = function(_inst: any, _k: any, v: any): boolean
@@ -65,7 +72,14 @@
 			-- the first re-run. The (B)-branch occupancy marker is already in
 			-- place, so the recursion below finds a hole-free chain list.
 			ModuleIdentity.assertOwnAtDispatch(module, state, "State") -- before the registration fire subscribes here
+			local parent: any = nil
+			if hoParent ~= nil and hoInst == inst and hoK == k and hoIndex == index then parent = hoParent end
+			hoInst, hoK, hoParent = nil, nil, nil
 			local observer = state:Observer(function()
+				-- [round13 Q114 (a) prototype] same-wave revalidation: the outer State already moved to a
+				-- different value (its own observer, later in this wave, rebinds this slot) — writing
+				-- now would show a branch the outer no longer selects (hash-order dependent)
+				if parent ~= nil and parent:Get() ~= state then return end
 				local realv = state:Get()
 				if isState(realv) then
 					-- round11 `H-573` (탐사 I′ 4): a State whose value chain loops back on itself
@@ -81,7 +95,9 @@
 						cur = cur:Get()
 					end
 				end
+				if isState(realv) then hoInst, hoK, hoIndex, hoParent = inst, k, index + 1, state end
 				dispatch.process(inst, k, realv, index + 1)
+				hoInst, hoK, hoParent = nil, nil, nil
 			end)
 			module.Backend.bindLifetime(inst, observer)
 			return function(_nextValue: any?, _retracting: boolean)
