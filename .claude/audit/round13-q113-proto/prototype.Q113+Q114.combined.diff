+			hoInst, hoK, hoParent = nil, nil, nil
 			local observer = state:Observer(function()
+				-- [round13 Q114 (a) prototype] same-wave revalidation: the outer State already moved to a
+				-- different value (its own observer, later in this wave, rebinds this slot) — writing
+				-- now would show a branch the outer no longer selects (hash-order dependent)
+				if parent ~= nil and parent:Get() ~= state then return end
 				local realv = state:Get()
-				if isState(realv) then
-					-- round11 `H-573` (탐사 I′ 4): a State whose value chain loops back on itself
-					-- (`a:Set(b); b:Set(a)`, or `s:Set(s)`) recursed through `index + 1` until
-					-- "Brand.luau: stack overflow" — walk the chain once with a visited set
-					local visited = { [state] = true }
-					local cur = realv
-					while isState(cur) do
-						if visited[cur] then
-							Err.errorBefore("Quad0070 StoreBind: the State's value chain is circular (a State that eventually holds itself) — a State may hold another State, but not a cycle", SURFACE)
-						end
-						visited[cur] = true
-						cur = cur:Get()
-					end
-				end
+				-- round11 `H-573` (탐사 I′ 4): a State whose value chain loops back on itself
+				-- (`a:Set(b); b:Set(a)`, or `s:Set(s)`) recursed through `index + 1` until
+				-- "Brand.luau: stack overflow" — walk the chain once with a visited set
+				StoreBind.assertAcyclicChain(realv, state, Err.errorBefore, "StoreBind") -- error-code: via assertAcyclicChain
+				if isState(realv) then hoInst, hoK, hoIndex, hoParent = inst, k, index + 1, state end
 				dispatch.process(inst, k, realv, index + 1)
