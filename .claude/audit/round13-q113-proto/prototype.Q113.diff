diff -ru src/Dispatch/StoreBind.luau ../../A/quad-base/src/Dispatch/StoreBind.luau
--- src/Dispatch/StoreBind.luau	2026-09-27 03:54:02.370020803 +0900
+++ ../../A/quad-base/src/Dispatch/StoreBind.luau	2026-09-27 03:55:00.810201513 +0900
@@ -48,6 +48,25 @@
 
 local StoreBind = {}
 
+-- [round13 Q113 (a) prototype] the one Quad0070 literal (error-codes: one id, one raise site), shared
+-- by StoreBind (above) and the Slot element path (`Slot/Elements.luau` wrapElement, `Slot/List.luau`
+-- identity reconcile) — the Slot side had no cycle check and overflowed in Brand/Relate. `first` is
+-- the value to walk from; `seed` (optional) is a State already on the chain (StoreBind's own state).
+-- `raise` is the caller's depth; `subject` names the surface ("StoreBind" / "Slot").
+function StoreBind.assertAcyclicChain(first: any, seed: any?, raise: (string, any) -> (), subject: string)
+	if not isState(first) then return end
+	local visited = {}
+	if seed ~= nil then visited[seed] = true end
+	local cur = first
+	while isState(cur) do
+		if visited[cur] then
+			raise("Quad0070 " .. subject .. ": the State's value chain is circular (a State that eventually holds itself) — a State may hold another State, but not a cycle", SURFACE)
+		end
+		visited[cur] = true
+		cur = cur:Get()
+	end
+end
+
 -- Called by InitDispatch once per module instance, after the Dispatch table
 -- is assembled (the factory pattern, `H-174`). addHandler tags the received
 -- functions into the shared error namespace itself.
