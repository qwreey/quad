T("D2 ref sugar/02 examples", function()
	local tax, shipping = Source(2), Source(3)
	local basePrice, otherPrice = Source(10), Source(100)
	local f = Op.Sum(tax, shipping)
	local a, b = basePrice:Apply(f), otherPrice:Apply(f)
	print("  ", a:Get(), b:Get()); tax:Set(5); print("  ", a:Get(), b:Get())
	print("  Not:", Source(true):Apply(Op.Not):Get())
	local bp, t2, sh = Source(1000), Source(100), Source(50)
	local total = bp:Apply(Op.Sum(t2, sh, 500)); print("  total:", total:Get()); t2:Set(200); print("  total:", total:Get())
	print("  clamp:", Source(150):Apply(Op.Clamp(0, Source(100))):Get())
	print("  band:", Source(0b1100):Apply(Op.Band(0b1010)):Get(), "shl:", Source(0b1100):Apply(Op.Shl(2)):Get())
	print("  alt:", Source(nil):Apply(Op.Alternative("Guest")):Get())
	local palette = Source({ Primary = "red", Size = 10 })
	print("  indexed:", palette:Apply(Op.Indexed("Primary")):Get(), palette:Apply(Op.Indexed("Size")):Get(), palette:Apply(Op.Indexed("Nope")):Get())
	print("  errs:", E(function() return Op.Sum("x") end))
	print("       ", E(function() return Op.Sum(1, nil) end))
	print("       ", E(function() return Op.Sum(1)(5) end))
	print("       ", E(function() return Source(5):Apply(Op.Indexed("x")):Get() end))
	print("       ", E(function() return Source(1):Apply(Op.Clamp(0, -5)):Get() end))
	print("  None into Sum target:", E(function() return Source(q.None):Apply(Op.Sum(1)):Get() end))
	print("  Clamp 3 args:", E(function() return Source(5):Apply(Op.Clamp(0, 10, 2)):Get() end))
	print("  Clamp(0) one arg:", E(function() return Op.Clamp(0) end))
end)
T("D3 ref sugar/01 + GS15 semantics", function()
	local ThemeProvider = Context.Provider("Theme")
	local UserProvider = Context.Provider("User")
	local rootCtx = Context():Set(ThemeProvider, { ButtonBg = "c40" }):Set(UserProvider, { Name = "q" })
	print("  tostring:", tostring(rootCtx), tostring(ThemeProvider))
	print("  Peek user:", rootCtx:Peek(UserProvider).Name)
	print("  Set nil msg:", E(function() rootCtx:Set(ThemeProvider, nil) end))
	print("  Get missing msg:", E(function() Context():Get(Context.Provider("Locale")) end))
	print("  Provider(5):", E(function() Context.Provider(5) end))
	-- GS15 runtime change: rows made before vs after ctx:Set
	local Instance = mock.Instance
	local rows = Source({ "a", "b" })
	local colors = {}
	local slot = q.Slot():List(rows, function(c)
		if c.Item == q.KeyGone then return nil end
		if c.Prev then return c.Prev end -- GS14 reuse branch
		local theme = rootCtx:Get(ThemeProvider)
		colors[c.Item] = theme.ButtonBg
		return Instance.new("Frame")
	end, function(item) return item end)
	local parent = Instance.new("Folder")
	q.Dispatch.drive(parent, { slot })
	rootCtx:Set(ThemeProvider, { ButtonBg = "green" })
	rows:Set({ "a", "b", "c" })
	print("  after runtime ctx:Set + new row:", colors.a, colors.b, colors.c)
end)
T("D4 GS16 Step cycle and Store-in-Context reactive", function()
	local settings = Store({ Step = Source(1) })
	local SettingsP = Context.Provider("Settings")
	local ctx = Context():Set(SettingsP, settings)
	local label = settings.Step:Compute(function(s) return `보폭: {s:Get()}` end)
	local seq = {}
	for i = 1, 6 do seq[#seq+1] = label:Get(); settings.Step:Set(settings.Step:Get() % 5 + 1) end
	print("  ", table.concat(seq, " | "))
	local count = Source(0)
	local st = ctx:Get(SettingsP)
	count:Set(count:Get() + st.Step:Get())
	print("  count after click with step", st.Step:Get(), "=", count:Get())
end)
