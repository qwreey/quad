T("S6 field deletion via nil: subscribers of old Source; Of recreates", function()
	local s = Store({ hp = Source(10) })
	local old = s.hp
	local dbl = old:Compute(function(h) return h:Get() * 2 end)
	local seen = {}
	local o = dbl:Observer(function(h) seen[#seen+1] = h:Get() end):Subscribe()
	s.hp = nil
	local new = s:Of("hp")
	print("  new == old:", new == old, "new:Get()=", new:Get())
	new:Set(99)
	print("  dbl after new:Set(99):", dbl:Get(), "seen:", table.concat(seen, ","))
	old:Set(5)
	print("  dbl after old:Set(5):", dbl:Get(), "Names:", table.concat(s:Names(), ","))
end)
