T("O7 chain depth — Operator on Operator result", function()
	for _, depth in { 100, 1000, 5000, 20000 } do
		local base = Source(0)
		local cur = base
		local ok, e = pcall(function()
			for i = 1, depth do cur = cur:Apply(Op.Sum(1)) end
			return cur:Get()
		end)
		print(`  depth {depth} first Get:`, ok and tostring(e) or ("ERR " .. tostring(e)))
		if ok then
			local ok2, e2 = pcall(function() base:Set(1); return cur:Get() end)
			print(`  depth {depth} after Set:`, ok2 and tostring(e2) or ("ERR " .. tostring(e2)))
		end
	end
end)
