--!nocheck
-- round13 E13 probe — Store · Context/Provider · Operator composition boundaries (not a spec).
-- Run from repo root: luau .claude/audit/round13-e13-probe.luau
local mock = require("../../quad-base/test/mock")
local q = mock.newQuad()
local Source, Store, Context, Op = q.Source, q.Store, q.Context, q.Operator
local function T(name, f)
	local ok, err = pcall(f)
	print(`--- {name}: {ok and "ok" or ("ERR " .. tostring(err))}`)
end
local function E(f, ...) local ok, e = pcall(f, ...); return ok and ("=> " .. tostring(e)) or ("ERR " .. tostring(e)) end

