--!nocheck
-- round13 E21 — error-id blame matrix. Run from repo root: `luau .claude/audit/round13-e21-blame/e21.luau`
-- Each C(...) case is ONE source line: the closure body is the "user call". The harness runs it
--   (1) direct:   pcall(fn)  -> blame prefix file:line; USER when it is this file at the case line
--   (2) callback: inside an Observer fn fired by an outer `s:Set(1)` (line OUTER below) — USER-INNER
--       when the blame is the case line, OUTER when it is the Set line (Q89 outermost), LEAF otherwise.
-- Output lines: R|id|label|mode|verdict|where|gotId|message(single line)
local H = require("../round13-e15-probe-setup")
local q, D, mock = H.q, H.D, H.mock
local M = D.Mapper
local Quad = require("../../../quad-roblox/luau_packages/quad_base")
local QuadRoblox = require("../../../quad-roblox/src").QuadRoblox
local QuadTypes = require("../../../quad-roblox/luau_packages/quad_types")

local q2 = Quad.New():UseProvider(QuadRoblox) -- a second module instance (ModuleIdentity cases)
q2.Backend.isInst = mock.isMockInstance
local qb = Quad.New() -- bare, no provider (NotInstalled stubs)

local THIS = "round13-e21-blame/e21.luau"
local function L(): number return debug.info(2, "l") end
local uidN = 0
local function uid(): string uidN += 1 return "E21C" .. uidN end
local function F(): any return D.Frame {} end
local function foreign(cls, name, parent) local i = mock.Instance.foreign(cls or "Frame"); if name then i.Name = name end; if parent then i.Parent = parent end; return i end
local function nop() end
local function frameFn() return D.Frame {} end

local function oneLine(s) return (string.gsub(string.gsub(s, "\n", " \\n "), "|", "¦")) end
local function classify(err: any, exp: number, outer: number?): (string, string, string)
	local s = tostring(err)
	local id = string.match(s, "Quad%d%d%d%d") or "-"
	local file, line = string.match(s, "^([^\n]-):(%d+): ")
	if not file then return "NOPREFIX", "-", id end
	local ln = tonumber(line)
	local short = (string.match(file, "src/(.*)$") or string.match(file, "[^/]+/[^/]+$") or file) .. ":" .. line
	if string.find(file, THIS, 1, true) then
		if ln == exp then return (if outer then "USER-INNER" else "USER"), short, id end
		if outer and ln == outer then return "OUTER", short, id end
		return "USER-OTHER", short, id
	end
	return "LEAF", short, id
end

local OUTER = 0
local function inCallback(fn): (boolean, any)
	local s = q.Source(0)
	local armed = false
	local o = s:Observer(function() if armed then fn() end end)
	o:Subscribe()
	armed = true
	local ok, err = pcall(function() OUTER = L(); s:Set(1) end)
	armed = false
	pcall(function() o:Unsubscribe() end)
	return ok, err
end

local rows = {}
local function emit(id, label, mode, verdict, where, got, msg)
	print(table.concat({ "R", id, label, mode, verdict, where, got, oneLine(msg) }, "|"))
end
-- C(id, label, line, fn [, noCb])
local function C(id: string, label: string, line: number, fn: () -> (), noCb: boolean?)
	local ok, err = pcall(fn)
	if ok then emit(id, label, "direct", "NO-RAISE", "-", "-", "")
	else
		local v, w, got = classify(err, line)
		emit(id, label, "direct", v, w, got, tostring(err))
	end
	if noCb then return end
	local ok2, err2 = inCallback(fn)
	if ok2 then emit(id, label, "cb", "NO-RAISE", "-", "-", "")
	else
		local v, w, got = classify(err2, line, OUTER)
		emit(id, label, "cb", v, w, got, tostring(err2))
	end
end
local function U(id: string, why: string)
	emit(id, why, "direct", "UNREACHABLE", "-", "-", "")
end

