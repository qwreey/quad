--!nocheck
local mock = require("./mock")
local Instance = mock.Instance
local q = mock.newQuad()
local function try(label, f)
	local ok, err = pcall(f)
	print(label, ok, err)
end
-- 1. same PreRef twice in one props table
try("preref-twice-same", function()
	local p = q.PreRef(nil)
	q.Dispatch.drive(Instance.new("Frame"), { p, p })
end)
-- 2. user-Set PreRef then placed
try("preref-userSet-then-place", function()
	local p = q.PreRef(nil)
	p:Set(Instance.new("Frame"))
	q.Dispatch.drive(Instance.new("Frame"), { p })
end)
-- 3. As<Class> unknown then As(name) with same unknown
try("As<Unknown>", function() local m = q.Modifier(); return m:AsNopeClass() end)
try("As(name) unknown", function() local m = q.Modifier(); return m:As("NopeClass") end)
-- 4. setOffsetSource on unregistered position (N nil)
try("setOffsetSource pos3 fresh owner", function()
	local inst = Instance.new("Frame")
	q.Bookkeeping.setOffsetSource(inst, 3, q.Source(0))
end)
-- 5. Quad0229 reachable via getOffsetAt
try("getOffsetAt hole", function()
	local inst = Instance.new("Frame")
	q.Bookkeeping.setEmpty(inst, 3)
end)
try("getOffsetAt hole2", function()
	local inst = Instance.new("Frame")
	q.Bookkeeping.setLength(inst, 3, 0)
end)
try("getOffsetAt hole3", function()
	local inst = Instance.new("Frame")
	local b = q.Bookkeeping.getBlocker(inst); b:On()
	q.Bookkeeping.setOffsetSource(inst, 3, q.None)
	q.Bookkeeping.setLength(inst, 3, 0)
	b:OffWithoutEmit()
	return q.Bookkeeping.getOffsetAt(inst, 2)
end)
-- 6. Quad0024 reachable
try("lengthList hole", function()
	local inst = Instance.new("Frame")
	q.Bookkeeping.setOffsetSource(inst, 1, q.None)
	q.Bookkeeping.setLength(inst, 2, 0)
end)
-- 7. drive with AttrKey (plain-branded, no metatable)
try("drive AttrKey", function()
	local k = q.AttrKey("x")
	print("mt", getmetatable(k))
	q.Dispatch.drive(Instance.new("Frame"), k)
end)
-- 8. Overridden colon no-args
try("Overridden colon", function() local m = q.Modifier(); return m:Overridden() end)
-- 9. sparse numeric key modifier
try("modifier at [5]", function() q.Dispatch.drive(Instance.new("Frame"), { [5] = q.Modifier() }) end)
