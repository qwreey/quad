--!nocheck
local mock = require("./mock")
local q = mock.newQuad()
local Instance = mock.Instance
local function case(name, fn)
	local ok, err = pcall(fn)
	print("@@RESULT\t" .. name .. "\t" .. (ok and "NO-ERROR" or tostring(err):gsub("\n", "\\n")))
end
case("0156 updateFn returns element held by manual slot", function()
	local el = Instance.new("Frame")
	local a = q.Slot({ el })
	q.Dispatch.drive(Instance.new("Folder"), { a })
	local s = q.Slot(); s:List(q.Source({ 1 }), function(ctx) if ctx.Item == q.KeyGone then return nil end return el end)
	q.Dispatch.drive(Instance.new("Folder"), { s })
end)
case("0156 updateFn same element two keys", function()
	local el = Instance.new("Frame")
	local s = q.Slot(); s:List(q.Source({ 1, 2 }), function(ctx) if ctx.Item == q.KeyGone then return nil end return el end)
	q.Dispatch.drive(Instance.new("Folder"), { s })
end)
case("0156 updateFn returns own slot", function()
	local s = q.Slot(); s:List(q.Source({ 1 }), function(ctx) if ctx.Item == q.KeyGone then return nil end return s end)
	q.Dispatch.drive(Instance.new("Folder"), { s })
end)
case("0156 :Single element held elsewhere", function()
	local el = Instance.new("Frame")
	local a = q.Slot({ el })
	q.Dispatch.drive(Instance.new("Folder"), { a })
	local s = q.Slot(); s:Single(q.Source(1), function(ctx) if ctx.Item == q.KeyGone then return nil end return el end)
	q.Dispatch.drive(Instance.new("Folder"), { s })
end)
case("0164 State<Slot> destroyed slot swap into nested", function()
	local outer = q.Slot()
	local st = q.Source(nil)
	local inner = q.Slot()
	q.dispose(inner)
	outer:List(q.Source({ 1 }), function(ctx) if ctx.Item == q.KeyGone then return nil end return inner end)
	q.Dispatch.drive(Instance.new("Folder"), { outer })
end)
