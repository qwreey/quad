--!nocheck
-- E28 triggers for ids the spec suite never raised
local mock = require("./mock")
local q = mock.newQuad()
local Instance = mock.Instance
local function case(name, fn)
	print("@@CASE\t" .. name)
	local ok, err = pcall(fn)
	print("@@RESULT\t" .. name .. "\t" .. (ok and "NO-ERROR" or tostring(err):gsub("\n", "\\n")))
end
case("Quad0003 Attr(Store with empty name)", function()
	local st = q.Store({ [""] = q.Source(1) })
	q.Attr(st)
end)
case("Quad0003b Store:Of empty name", function()
	local st = q.Store({ a = q.Source(1) })
	st:Of({ [""] = 1 })
end)
case("Quad0004/0009 Merged with Store/plain", function()
	q.Attr.Merged(q.Attr({ a = 1 }), q.Store({ a = q.Source(2) }))
end)
case("Quad0009 Merged plain", function()
	q.Attr.Merged(q.Attr({ a = 1 }), { a = 2 })
end)
case("Quad0012 Overridden non-Attr", function()
	q.Attr.Overridden(q.Attr({ a = 1 }), { a = 2 })
end)
case("Quad0024 lengthList hole", function()
	local inst = Instance.new("Frame")
	local s1 = q.Source(0)
	q.Bookkeeping.setOffsetSource(inst, 1, s1)
	q.Bookkeeping.setOffsetSource(inst, 2, q.Source(0))
	q.Bookkeeping.setLength(inst, 2, 1)
	s1:Set(3)
end)
case("Quad0045 Debounce non-table", function()
	q.Debounce(5)
end)
case("Quad0045b Throttle nil", function()
	q.Throttle()
end)
case("Quad0089 Effect WeakSubscribe after Subscribe", function()
	local e = q.Effect(function() end, q.Source(1))
	e:Subscribe()
	e:WeakSubscribe()
end)
case("Quad0230 Effect WeakSubscribe when bound", function()
	local e = q.Effect(function() end, q.Source(1))
	q.Backend.bindLifetime(Instance.new("Frame"), e)
	e:WeakSubscribe()
end)
case("Quad0231 Effect Subscribe when bound", function()
	local e = q.Effect(function() end, q.Source(1))
	q.Backend.bindLifetime(Instance.new("Frame"), e)
	e:Subscribe()
end)
case("Quad0234 Observer WeakSubscribe when bound", function()
	local o = q.Source(1):Observer(function() end)
	q.Backend.bindLifetime(Instance.new("Frame"), o)
	o:WeakSubscribe()
end)
case("Quad0235 Observer Subscribe when bound", function()
	local o = q.Source(1):Observer(function() end)
	q.Backend.bindLifetime(Instance.new("Frame"), o)
	o:Subscribe()
end)
case("Quad0134 Ref Wait main thread", function()
	local r = q.Ref(nil)
	string.gsub("a", "a", function() r:Wait() end)
end)
case("Quad0140 destroyed Slot mounted top-level", function()
	local s = q.Slot()
	q.dispose(s)
	q.Dispatch.drive(Instance.new("Folder"), { s })
end)
case("Quad0164 destroyed Slot nested", function()
	local outer = q.Slot()
	local inner = q.Slot()
	outer:Add(inner)
	q.dispose(inner)
	q.Dispatch.drive(Instance.new("Folder"), { outer })
end)
case("Quad0142 List data State set to non-table", function()
	local data = q.Source({ 1, 2 })
	local s = q.Slot(); s:List(data, function(ctx) if ctx.Item == q.KeyGone then return nil end return ctx.Prev or Instance.new("Frame") end)
	q.Dispatch.drive(Instance.new("Folder"), { s })
	data:Set(5)
end)
case("Quad0142b List data plain non-table", function()
	local s = q.Slot(); s:List(5, function(ctx) return Instance.new("Frame") end)
	q.Dispatch.drive(Instance.new("Folder"), { s })
end)
case("Quad0145 List duplicate key", function()
	local s = q.Slot(); s:List(q.Source({ { id = 1 }, { id = 1 } }), function(ctx) return Instance.new("Frame") end, function(v) return v.id end)
	q.Dispatch.drive(Instance.new("Folder"), { s })
end)
case("Quad0163 releaseOwner wrong key", function()
	q.Bookkeeping.releaseOwner(Instance.new("Frame"), {})
end)
case("Quad0180 dispose plain table", function()
	q.dispose({})
end)
case("Quad0180b dispose number", function()
	q.dispose(5)
end)
case("Quad0190 Observer non-function", function()
	q.Source(1):Observer(5)
end)
case("Quad0229 getOffsetAt hole", function()
	local inst = Instance.new("Frame")
	q.Bookkeeping.setOffsetSource(inst, 1, q.Source(0))
	q.Bookkeeping.setLength(inst, 1, 1)
	q.Bookkeeping.setLength(inst, 3, 1)
	q.Bookkeeping.getOffsetAt(inst, 3)
end)
case("Quad0156 claimOwner", function()
	local el = Instance.new("Frame")
	local a = q.Slot()
	a:Add(el)
	q.Dispatch.drive(Instance.new("Folder"), { a })
	local b = q.Slot({ el })
	q.Dispatch.drive(Instance.new("Folder"), { b })
end)

case("Quad0164b destroyed nested after dispose-inner-while-held", function()
	local outer = q.Slot()
	local inner = q.Slot()
	q.dispose(inner)
	outer:Add(inner)
end)
case("Quad0142c List plain table data", function()
	local s = q.Slot(); s:List({ 1 }, function(ctx) return Instance.new("Frame") end)
	q.Dispatch.drive(Instance.new("Folder"), { s })
end)
