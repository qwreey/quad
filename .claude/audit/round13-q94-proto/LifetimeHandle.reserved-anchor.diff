+		gchold[GCCONN_ANCHOR] = gcconn -- reserved key (Q94 (b)); bound values are their own keys and cannot collide
 		InstData:SetWeak(inst, "gchold", gchold)
 		InstData:SetWeak(inst, "gcconn", gcconn)
 	end
@@ -136,7 +142,7 @@
