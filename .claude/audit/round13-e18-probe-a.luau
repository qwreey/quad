--!nocheck
-- round13 E18 probe A (2026-09-27) — cross-instance matrix on quad-base + mock. Run from repo root: luau .claude/audit/round13-e18-probe-a.luau
local Quad = require("../../quad-base/src")
local mock = require("../../quad-base/test/mock")
local Instance = mock.Instance
local A, B = Quad.New(), Quad.New()
mock.installLifetime(A)
mock.installLifetime(B)
local function E(f)
	local ok, err = pcall(f)
	if ok then return "ok" end
	local s = tostring(err)
	return (s:match("Quad%d+[^\n]*") or s):sub(1, 150)
end
local function T(name, f) print(name .. " => " .. E(f)) end

print("== leaf sharing ==")
for _, k in { "Void", "Ref", "PreRef", "PostRef", "Relate", "Blocker", "None", "Tag", "Modifier", "Attr", "AttrKey", "Context", "Operator", "Fallback", "Traceback", "errorNamespace", "isState", "isSlot", "isEffect", "Source", "Slot", "Effect", "Store", "Claim", "dispose", "Debounce", "OnCreated", "OnDestroyed", "Dispatch", "Bookkeeping", "Backend", "isEpoch", "Detach", "KeyGone", "MapperRoot" } do
	local a, b = A[k], B[k]
	print(k, a == nil and "nil" or (a == b and "SHARED" or "per-instance"))
end
print("A.isState(B.Source(1))", A.isState(B.Source(1)), "A.isSlot(B.Slot())", A.isSlot(B.Slot()))

print("== guarded doors (expected Quad0106) ==")
T("drive numeric B.Observer", function() A.Dispatch.drive(Instance.new("Frame"), { B.Source(1):Observer(function() end) }) end)
T("drive numeric B.Effect", function() A.Dispatch.drive(Instance.new("Frame"), { B.Effect(function() end) }) end)
T("drive numeric A.Source(B.Effect)", function() A.Dispatch.drive(Instance.new("Frame"), { A.Source(B.Effect(function() end)) }) end)
T("drive numeric A.Source(B.Source(B.Effect))", function() A.Dispatch.drive(Instance.new("Frame"), { A.Source(B.Source(B.Effect(function() end))) }) end)
T("drive string key B.Source", function() A.Dispatch.drive(Instance.new("Frame"), { Name = B.Source("x") }) end)
T("drive string key A.Source(B.Source)", function() A.Dispatch.drive(Instance.new("Frame"), { Name = A.Source(B.Source("x")) }) end)
T("drive Modifier{Name=B.Source}", function() A.Dispatch.drive(Instance.new("Frame"), { A.Modifier { Name = B.Source("x") } }) end)
T("drive B.Source:Compute result", function() A.Dispatch.drive(Instance.new("Frame"), { Name = B.Source(1):Compute(function(v) return tostring(v) end) }) end)
T("drive B gate (Debounce)", function() A.Dispatch.drive(Instance.new("Frame"), { Name = B.Debounce(B.Source("x"), { Time = 1 }) }) end)
T("drive A.Operator on B state", function() A.Dispatch.drive(Instance.new("Frame"), { Name = A.Operator.Not(B.Source(true)) }) end)
T("drive B.OnDestroyed hook", function() A.Dispatch.drive(Instance.new("Frame"), { B.OnDestroyed(function() end) }) end)
T("drive B.OnCreated hook (PreRef leaf)", function() A.Dispatch.drive(Instance.new("Frame"), { B.OnCreated(function() end) }) end)
T("drive B.OnRendered hook (PostRef leaf)", function() A.Dispatch.drive(Instance.new("Frame"), { B.OnRendered(function() end) }) end)
T("drive Attr{Hp=B.Source}", function() A.Dispatch.drive(Instance.new("Frame"), { A.Attr { Hp = B.Source(1) } }) end)
T("drive AttrKey = B.Source", function() A.Dispatch.drive(Instance.new("Frame"), { [A.AttrKey("Hp")] = B.Source(1) }) end)
T("drive Tag state B.Source(A.Tag)", function() A.Dispatch.drive(Instance.new("Frame"), { B.Source(A.Tag("x")) }) end)
T("A.Slot():Add(B.Effect)", function() A.Slot():Add(B.Effect(function() end)) end)
T("A.Slot():Add(B.Observer)", function() A.Slot():Add(B.Source(1):Observer(function() end)) end)
T("A.dispose(B.Effect)", function() A.dispose(B.Effect(function() end)) end)
T("A.dispose(B.Observer)", function() A.dispose(B.Source(1):Observer(function() end)) end)

print("== unguarded (documented UB or not) ==")
T("A.bindLifetime(inst, B.Effect)", function()
	local inst = Instance.new("Frame")
	A.Dispatch.drive(inst, {})
	local runs = 0
	local e = B.Effect(function() runs += 1 end)
	A.Backend.bindLifetime(inst, e)
	print("   runs after bind:", runs, "A.canExecute", A.canExecute and A.canExecute(e), "B.canExecute", B.canExecute and B.canExecute(e))
end)
T("B.Effect(fn, A.source) dep edge", function()
	local s = A.Source(1); local n = 0
	local e = B.Effect(function() n += 1 end, s); e:Subscribe(); s:Set(2); print("   runs", n); e:Unsubscribe()
end)
T("A.Source(1):Depend(B.Source(2))", function()
	local b = B.Source(2)
	local a = A.Source(1):Depend(b)
	print("   depend ok; a instance?", A.isState(a))
end)
T("A.Source(1):Compute with B dep", function()
	local b = B.Source(2)
	local c = A.Source(1):Compute(function(v) return v + b:Get() end)
end)
T("Store: A.Store{ x = B.Source(1) }", function()
	local st = A.Store({ x = B.Source(1) })
	print("   st.x identity is B's?", st.x._moduleIdentity == B.moduleIdentity)
	A.Dispatch.drive(Instance.new("Frame"), { Name = st.x })
end)
T("Store: B.Store bound in A drive via field", function()
	local st = B.Store({ x = "a" })
	A.Dispatch.drive(Instance.new("Frame"), { Name = st.x })
end)
T("Blocker B shared into A.Slot", function()
	local blk = B.Blocker()
	print("   blocker", tostring(blk))
end)
T("Ref from A used in B drive", function()
	local r = A.Ref()
	local inst = Instance.new("Frame")
	B.Dispatch.drive(inst, { r })
	print("   ref value set:", r:Get() == inst)
end)
T("B Slot as A.Slot():List data element? (List returns B.Slot)", function()
	local host = Instance.new("Frame")
	local l = A.Slot()
	l:List(A.Source({ 1 }), function() return B.Slot() end)
	A.Dispatch.drive(host, { l })
end)
T("Claim cross: A.Claim(inst, B mapper)", function()
	local inst = Instance.new("Frame")
	local M = B.Claim
	print("   B.Claim ~= A.Claim", B.Claim ~= A.Claim)
end)
