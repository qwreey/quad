--!nocheck
-- Reads cases.luau (generated by fuzz.py), prints one line per pair: "1" match / "0" no match / "E<msg>" raised.
local T = require("../../../type-version-check/src")
local cases = require("./cases")
local out = table.create(#cases)
for i, c in cases do
	local ok, r = pcall(T.matchesPattern, c[1], c[2])
	out[i] = if not ok then "E" .. tostring(r):gsub("\n", " ") elseif r then "1" else "0"
end
print(table.concat(out, "\n"))
