--!nocheck
-- E80 group F: Debounce/Throttle Fixed bullets (F6 F23 F34)
local H = require("../harness")
local L = require("../lib")
local q = H.q

print("--- F6: Trailing=false Debounce는 MaxTime을 읽지 않는다; 게이트 핸들 Flush blame ---")
L.section(function()
	local reads = 0
	local maxT = q.Source(1):Compute(function(self) reads += 1; return self:Get() end)
	local src = q.Source(0)
	local d = src:Apply(q.Debounce({ Time = 0.5, Leading = true, Trailing = false, MaxTime = maxT }))
	d:Observer(function() end):Subscribe()
	src:Set(1); src:Set(2); src:Set(3)
	L.check("F6 MaxTime Compute never ran", reads == 0, reads)
	local bad = q.Source(-1)
	local src2 = q.Source(0)
	local d2 = src2:Apply(q.Debounce({ Time = 0.5, Leading = true, Trailing = false, MaxTime = bad }))
	d2:Observer(function() end):Subscribe()
	local ok, e = pcall(function() src2:Set(1) end)
	L.check("F6 invalid unused MaxTime does not throw", ok, ok and "ok" or L.first(e))
	H.runTask(2)
	local bare = H.Quad.New()
	local s = bare.Source(0)
	local h = bare.Ref(nil)
	local g = s:Apply(bare.Debounce({ Time = 1, Handle = h }))
	pcall(function() s:Set(1) end)
	local m, id = L.err("F6 handle Flush on backend-less quad", function() h.Value:Flush() end)
	L.check("F6 Flush blame user line", L.has(m, "f-debounce.luau") and not L.has(m, "Debounce.luau"), id)
end)

print("--- F23: 창 끝 통과 도중 하류 Cancel → 창을 다시 열지 않음 ---")
L.section(function()
	local s = q.Source(0)
	local h = q.Ref(nil)
	local g = s:Apply(q.Throttle({ Time = 1, Handle = h }))
	local seen = {}
	local once = true
	g:Observer(function(st)
		table.insert(seen, st:Get())
		if once and st:Get() == 2 then once = false; h.Value:Cancel() end
	end):Subscribe()
	table.clear(seen)
	s:Set(1); s:Set(2)
	H.runTask(1)
	s:Set(3)
	L.check("F23 next leading passes immediately", seen[#seen] == 3, table.concat(seen, ","))
	H.runTask(3)
end)

print("--- F34: Time이 State이고 값이 잘못되면 게이트가 굳지 않는다; 신호 진입 때 한 번 읽음 ---")
L.section(function()
	local t = q.Source(-1)
	local s = q.Source(0)
	local g = s:Apply(q.Debounce({ Time = t }))
	local seen = {}
	g:Observer(function(st) table.insert(seen, st:Get()) end):Subscribe()
	table.clear(seen)
	local m, id = L.err("F34 bad Time on signal", function() s:Set(1) end)
	L.check("F34 gate not left blocked after the throw (g follows s)", g:Get() == s:Get(), "g=" .. tostring(g:Get()) .. " s=" .. tostring(s:Get()))
	t:Set(0.5)
	local ok, e = pcall(function() s:Set(2) end)
	H.runTask(1)
	L.check("F34 not stuck after bad Time (next signal works, trailing flushes)", ok and seen[#seen] == 2, (ok and "" or L.first(e)) .. " seen=" .. table.concat(seen, ","))
	-- 3.2.0 경로: 창 안에서 Time State가 잘못된 값으로 바뀐 뒤 trailing 통과가 창을 다시 열 때 Time을 다시 읽던 것
	local tt = q.Source(1)
	local ss = q.Source(0)
	local gg = ss:Apply(q.Throttle({ Time = tt }))
	local seenT = {}
	gg:Observer(function(st) table.insert(seenT, st:Get()) end):Subscribe()
	table.clear(seenT)
	ss:Set(1); ss:Set(2)
	tt:Set(-1)
	H.runTask(1.01) -- window end: trailing 2 passes, reopen
	L.err("F34 next signal with the bad Time (HEAD: throws at the :Set line)", function() ss:Set(3) end)
	tt:Set(1)
	ss:Set(4)
	H.runTask(5)
	print("  F34 throttle seen after bad Time mid-window: " .. table.concat(seenT, ","))
	L.check("F34 bad Time mid-window: gate recovers once Time is valid (4 passes)", seenT[#seenT] == 4, table.concat(seenT, ","))
	-- Time change without signal: applies from next signal
	table.clear(seen)
	local t2 = q.Source(1)
	local s2 = q.Source(0)
	local g2 = s2:Apply(q.Debounce({ Time = t2 }))
	g2:Observer(function(st) table.insert(seen, st:Get()) end):Subscribe()
	table.clear(seen)
	s2:Set(1)
	t2:Set(3) -- no signal
	H.runTask(1.01)
	L.check("F34 running window uses the value read at the signal", seen[#seen] == 1, table.concat(seen, ","))
	-- MaxTime invalid → throws at :Set line, gate state unchanged
	local s3 = q.Source(0)
	local mt = q.Source(-5)
	local g3 = s3:Apply(q.Debounce({ Time = 0.5, MaxTime = mt }))
	local seen3 = {}
	g3:Observer(function(st) table.insert(seen3, st:Get()) end):Subscribe()
	table.clear(seen3)
	local m3, id3 = L.err("F34 invalid MaxTime", function() s3:Set(1) end)
	L.check("F34 MaxTime throws at user line", L.has(m3, "f-debounce.luau"), id3)
	mt:Set(2)
	s3:Set(2)
	H.runTask(1)
	L.check("F34 gate fine after MaxTime fix", seen3[#seen3] == 2, table.concat(seen3, ","))
	-- Flush on a gate that never opened: pending passes, no window
	local tb = q.Source("x")
	local s4 = q.Source(0)
	local h4 = q.Ref(nil)
	local g4 = s4:Apply(q.Debounce({ Time = tb, Handle = h4 }))
	local seen4 = {}
	g4:Observer(function(st) table.insert(seen4, st:Get()) end):Subscribe()
	table.clear(seen4)
	pcall(function() s4:Set(7) end)
	local okF, eF = pcall(function() h4.Value:Flush() end)
	L.check("F34 Flush on never-opened gate passes pending", okF and seen4[#seen4] == 7, (okF and "" or L.first(eF)) .. " seen=" .. table.concat(seen4, ","))
end)
L.done()
