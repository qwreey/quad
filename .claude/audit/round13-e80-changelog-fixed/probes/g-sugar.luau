--!nocheck
-- E80 group G: Modifier/Operator/Blocker Fixed bullets (F10 F24 F36 F25 F37 F39)
local H = require("../harness")
local L = require("../lib")
local q, D = H.q, H.D

print("--- F10: Modifier({ __apply = … }) 생성 줄 거부 ---")
L.section(function()
	local m, id = L.err("F10 __apply field", function() q.Modifier({ __apply = 1 }) end)
	L.check("F10 message", L.has(m, 'Modifier: field "__apply" starts with "__"') and L.has(m, "g-sugar.luau"), id)
	local m2 = L.err("F10 __foo field", function() q.Modifier({ __foo = 1 }) end)
end)

print("--- F24: state:Apply(modifier) → Apply가 비팩토리 값과 같은 문구로 거부 ---")
L.section(function()
	local mod = q.Modifier({ Name = "x" })
	local m, id = L.err("F24 Apply(modifier)", function() q.Source(1):Apply(mod) end)
	local m2, id2 = L.err("F24 Apply(5) control", function() q.Source(1):Apply(5) end)
	L.check("F24 same wording as non-factory", id ~= nil and id == id2, tostring(id) .. " vs " .. tostring(id2))
end)

print("--- F36: Modifier 초기 필드 함수 안내 ---")
L.section(function()
	local m, id = L.err("F36 Modifier({ Activated = fn })", function() q.Modifier({ Activated = function() end }) end)
	L.check("F36 guidance mentions inline key or State for events", m ~= nil and (L.has(m, "event") or L.has(m, "Event")), id)
end)

print("--- F25: Operator.Clamp min>max/NaN → 읽는 줄 에러; Indexed(State) → 팩토리 줄 거부 ---")
L.section(function()
	local lo = q.Source(10)
	local v = q.Source(5):Apply(q.Operator.Clamp(lo, 1))
	local m, id = L.err("F25 Clamp min>max read", function() return v:Get() end)
	L.check("F25 Clamp message at reading line", L.has(m, "Operator.Clamp: min must be <= max and neither NaN") and L.has(m, "g-sugar.luau"), id)
	local v2 = q.Source(5):Apply(q.Operator.Clamp(0 / 0, 1))
	local m2 = L.err("F25 Clamp NaN read", function() return v2:Get() end)
	local m3, id3 = L.err("F25 Indexed(State)", function() q.Operator.Indexed(q.Source("k")) end)
	L.check("F25 Indexed(State) rejected at factory line", m3 ~= nil and L.has(m3, "g-sugar.luau"), id3)
end)

print("--- F37: Operator Sum 등 nil 값 State 인자 → 읽는 시점 에러 ---")
L.section(function()
	local a = q.Source(nil)
	local v = q.Source(1):Apply(q.Operator.Sum(a))
	local m, id = L.err("F37 Sum nil State", function() return v:Get() end)
	L.check("F37 message", L.has(m, "Operator.Sum: argument #") and L.has(m, "is a State whose current value is nil"), id)
	for _, name in { "Product", "Min", "Max", "Band", "Bor", "Bxor" } do
		local w = q.Source(1):Apply(q.Operator[name](q.Source(nil)))
		local mm = L.err("F37 " .. name, function() return w:Get() end)
	end
	local w2 = q.Source(1):Apply(q.Operator.Clamp(q.Source(nil), 5))
	L.err("F37 Clamp nil State", function() return w2:Get() end)
	local w3 = q.Source(1):Apply(q.Operator.Shl(q.Source(nil)))
	L.err("F37 Shl nil State", function() return w3:Get() end)
end)

print("--- F39: Blocker __apply non-State ---")
L.section(function()
	local b = q.Blocker()
	local m, id = L.err("F39 b:__apply(5)", function() return b:__apply(5) end)
	L.check("F39 message", L.has(m, "Blocker: Apply target must be a State"), id)
end)
L.done()
