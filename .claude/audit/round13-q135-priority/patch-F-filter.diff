diff --git a/quad-base/src/Dispatch/init.luau b/quad-base/src/Dispatch/init.luau
index b27b34a2..899fef9a 100644
--- a/quad-base/src/Dispatch/init.luau
+++ b/quad-base/src/Dispatch/init.luau
@@ -599,6 +599,39 @@ local function Init(module: any)
 	-- `H-278`'s scope was leaf handlers for one value type). It needs `module`
 	-- too: lifetime fields are read at fire time (`H-174`).
 	StoreBindModule.register(Dispatch, module)
+	-- Q135 proto (variant F — "one filter between NORMAL and HIGH"): Dispatch owns ONE slot and NO brand
+	-- knowledge. Value modules keep their dynamic-path guards (`H-278`: registered at FALLBACK from their
+	-- own Init, messages and ids unchanged) and ALSO hand the same guard table to `module._earlyGuards`;
+	-- this filter runs those guards' predicates for non-number keys ahead of the NORMAL band (Property/
+	-- Event/Shorthand), so a quad value at a reflected key meets its own guard. Number keys are left to
+	-- the chain as before (leaf handlers at HIGH, the FALLBACK guards for Quad0136 / a raw `[0]`).
+	-- Fast path: a non-table value (strings, numbers, booleans, engine userdata — most property values)
+	-- costs one call + two `type` checks; only tables walk the guard list.
+	local earlyGuards: { Handler } = {}
+	module._earlyGuards = earlyGuards
+	local function matchEarly(inst: any, k: any, v: any): Handler?
+		if type(k) == "number" or type(v) ~= "table" then
+			return nil
+		end
+		for _, g in earlyGuards do
+			if g.isHandlable(inst, k, v) then
+				return g
+			end
+		end
+		return nil
+	end
+	Dispatch.addHandler({
+		name = "EarlyGuardFilter",
+		isHandlable = function(inst: any, k: any, v: any): boolean
+			return matchEarly(inst, k, v) ~= nil
+		end,
+		priority = HANDLER_PRIORITY_HIGH - 1,
+		process = function(inst: any, k: any, v: any, index: number): (any?, boolean) -> ()
+			-- the guard throws its own Quad01xx (errorBefore — user's line); matchEarly cannot be nil here
+			local g = matchEarly(inst, k, v) :: Handler
+			return g.process(inst, k, v, index)
+		end,
+	})
 	-- M3 unit 4 leaf handlers + guards: registered by their OWNING modules
 	-- (`H-278`, user-directed — Observer.luau/Effect.luau pull InitDispatch
 	-- via RunInit and addHandler in their own Init; "각 객체를 아는 곳은 각
