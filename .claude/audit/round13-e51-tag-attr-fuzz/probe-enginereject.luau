--!nocheck
-- engine-side setAttr rejection (mock: table value, H-748 gate — stands in for Roblox's invalid-name/invalid-type errors)
local H = require("./harness")
local mock, Instance = H.mock, H.Instance
local q = H.newQ({})
local function try(f) local ok, e = pcall(f) return ok and "ok" or H.idOf(e) end
local inst = Instance.new("Frame")
local bad = q.Source({})
local G = q.Source(q.Attr({ A = bad }))
print("drive group{A=State({})}:", try(function() q.Dispatch.drive(inst, { G }) end))
print("G <- Attr{A=1} (new group object):", try(function() G:Set(q.Attr({ A = 1 })) end), "A=", mock.getAttributes(inst).A)
local inst2 = Instance.new("Frame")
local k = q.Source({})
print("drive [AttrKey A]=State({}):", try(function() q.Dispatch.drive(inst2, { [q.AttrKey("A")] = k }) end))
print("same AttrKey recovers k:Set(1):", try(function() k:Set(1) end), "A=", mock.getAttributes(inst2).A)
local G2 = q.Source(q.Attr({ A = 2 }))
print("another group on inst2 for A:", try(function() q.Dispatch.drive(inst2, { G2 }) end))
print("-- reactive: valid at drive, engine rejects later")
local inst3 = Instance.new("Frame")
local v = q.Source(1)
local G3 = q.Source(q.Attr({ A = v }))
q.Dispatch.drive(inst3, { G3 })
print("v <- {}:", try(function() v:Set({}) end), "A=", mock.getAttributes(inst3).A)
print("v <- 2 (same private key recovers?):", try(function() v:Set(2) end), "A=", mock.getAttributes(inst3).A)
print("G3 <- Attr{A=3} (new group):", try(function() G3:Set(q.Attr({ A = 3 })) end), "A=", mock.getAttributes(inst3).A)
local inst4 = Instance.new("Frame")
local G4 = q.Source(q.Attr({ A = 1 }))
q.Dispatch.drive(inst4, { G4 })
local badv = q.Source({})
print("G4 <- Attr{A=State({})}:", try(function() G4:Set(q.Attr({ A = badv })) end), "A=", mock.getAttributes(inst4).A)
print("G4 <- Attr{A=5} after engine reject:", try(function() G4:Set(q.Attr({ A = 5 })) end), "A=", mock.getAttributes(inst4).A)
print("badv <- 7 (zombie?):", try(function() badv:Set(7) end), "A=", mock.getAttributes(inst4).A)
