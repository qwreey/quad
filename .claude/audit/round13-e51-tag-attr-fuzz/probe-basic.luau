--!nocheck
local H = require("./harness")
local mock, Instance = H.mock, H.Instance
local function try(label, f)
	local ok, e = pcall(f)
	print(label, ok and "OK" or ("ERR " .. H.idOf(e) .. " :: " .. tostring(e):sub(1, 160)))
end
local log = {}
local q = H.newQ(log)
local function dump(inst, l) print("  tags=", table.concat(mock.getTags(inst), ","), "log=", table.concat(log, " | ")) table.clear(log) end

print("== None at number key")
local i1 = Instance.new("Frame")
try("drive None", function() q.Dispatch.drive(i1, { q.None }) end)
try("Tag(None)", function() q.Tag(q.None) end)
print("== State<Tag> -> nil -> Tag")
local i2 = Instance.new("Frame")
local s = q.Source(q.Tag("a"))
q.Dispatch.drive(i2, { s }) dump(i2)
s:Set(nil) dump(i2)
s:Set(q.Tag("a","b")) dump(i2)
s:Set(q.None) dump(i2)
try("Set None", function() end)
s:Set(q.Tag("b")) dump(i2)
print("== State Tag -> Attr group")
local g = q.Attr({ X = 1 })
try("set attr group", function() s:Set(g) end) dump(i2)
print("  attrs X=", mock.getAttributes(i2).X)
s:Set(q.Tag("b")) dump(i2)
print("  attrs X=", mock.getAttributes(i2).X)
print("== Modifier with Tag")
local i3 = Instance.new("Frame")
try("Modifier{Tag}", function() local m = q.Modifier({ q.Tag("m") }) q.Dispatch.drive(i3, { m }) end) dump(i3)
print("== Destroy")
local i4 = Instance.new("Frame")
q.Dispatch.drive(i4, { q.Tag("d"), q.Attr({Y=2}) }) dump(i4)
i4:Destroy() dump(i4)
print("== AttrKey collisions")
local i5 = Instance.new("Frame")
try("AttrKey then group", function() q.Dispatch.drive(i5, { [q.AttrKey("X")] = 1, q.Attr({ X = 2 }) }) end) dump(i5)
print("  attrs", mock.getAttributes(i5).X)
local i6 = Instance.new("Frame")
try("group then AttrKey", function() q.Dispatch.drive(i6, { q.Attr({ X = 2 }), [q.AttrKey("X")] = 1 }) end) dump(i6)
print("  attrs", mock.getAttributes(i6).X)
print("== two groups same name")
local i7 = Instance.new("Frame")
try("two groups", function() q.Dispatch.drive(i7, { q.Attr({ X = 2 }), q.Attr({ X = 3 }) }) end) dump(i7)
print("  attrs", mock.getAttributes(i7).X)
print("== drive return")
local i8 = Instance.new("Frame")
local r = q.Dispatch.drive(i8, { q.Tag("z") })
print("  drive returned", typeof(r), r)
