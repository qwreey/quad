--!nocheck
local H = require("./harness")
local mock, Instance = H.mock, H.Instance
local log = {}
local q = H.newQ(log)
local function dump(inst) local a = mock.getAttributes(inst) local t = {} for k,v in a do table.insert(t, k.."="..tostring(v)) end table.sort(t) print("  tags=", table.concat(mock.getTags(inst), ","), "attrs=", table.concat(t, ","), "log=", table.concat(log, " | ")) table.clear(log) end
local inst = Instance.new("Frame")
local s = q.Source(1)
q.Dispatch.drive(inst, { [q.AttrKey("K")] = s }) dump(inst)
s:Set(1) print("same val") dump(inst)
s:Set(nil) print("nil") dump(inst)
s:Set(nil) print("nil again") dump(inst)
s:Set(q.None) print("None") dump(inst)
s:Set(2) dump(inst)
print("literal None at AttrKey")
local i2 = Instance.new("Frame")
q.Dispatch.drive(i2, { [q.AttrKey("K")] = q.None }) dump(i2)
print("group with None and inner state")
local inner = q.Source(nil)
local g = q.Source(q.Attr({ A = q.None, B = inner }))
local i3 = Instance.new("Frame")
q.Dispatch.drive(i3, { g }) dump(i3)
inner:Set(5) dump(i3) inner:Set(q.None) dump(i3) inner:Set(nil) dump(i3)
print("group replaced by other group w/o B; inner still writes?")
g:Set(q.Attr({ A = 3 })) dump(i3)
inner:Set(7) dump(i3)
print("same Tag set new object")
local ts = q.Source(q.Tag("a"))
local i4 = Instance.new("Frame")
q.Dispatch.drive(i4, { ts }) dump(i4)
ts:Set(q.Tag("a")) dump(i4)
print("destroy then set")
local i5 = Instance.new("Frame")
local t5 = q.Source(q.Tag("a")) local a5 = q.Source(q.Attr({ Q = 1 })) local k5 = q.Source(1)
q.Dispatch.drive(i5, { t5, a5, [q.AttrKey("R")] = k5 }) dump(i5)
i5:Destroy() dump(i5)
t5:Set(q.Tag("b")) a5:Set(q.Attr({ Q = 2 })) k5:Set(3) dump(i5)
