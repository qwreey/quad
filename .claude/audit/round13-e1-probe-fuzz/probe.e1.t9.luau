--!nocheck
local mock = require("./mock")
local q = mock.newQuad()
local Instance, Slot, dispatch = mock.Instance, q.Slot, q.Dispatch
local function F(n) local f = Instance.new("Frame"); f.Name = n; return f end
local parent = Instance.new("Folder")
local fa, fb, fc = F("a"), F("b"), F("c")
local sa, sb = q.Source(fa), q.Source(fb)
local s = Slot({ sa, sb, fc })
dispatch.drive(parent, { s })
s:Remove(1)
print("Remove(State elem): frame destroyed?", mock.isDestroyed(fa), "Parent", fa.Parent)
s:Replace(1, F("n"))
print("Replace(State elem): frame destroyed?", mock.isDestroyed(fb), "Parent", fb.Parent)
s:Clear()
print("Clear plain:", mock.isDestroyed(fc))
local sd = q.Source(F("d"))
local s2 = Slot({ sd })
dispatch.drive(Instance.new("Folder"), { s2 })
local d = sd:Get()
s2:Clear()
print("Clear(State elem): frame destroyed?", mock.isDestroyed(d), "Parent", d.Parent)
local se = q.Source(F("e")); local e = se:Get()
local s3 = Slot({ se })
local host = Instance.new("Folder")
dispatch.drive(host, { s3 })
q.dispose(host)
print("host disposed: State elem frame destroyed?", mock.isDestroyed(e))
