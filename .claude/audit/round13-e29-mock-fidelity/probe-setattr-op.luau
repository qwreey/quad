--!nocheck
local mock = require("../../../quad-base/test/mock")
local q = mock.newQuad()
local inst = mock.Instance.new("Frame")
local ok, err = pcall(function() q.Dispatch.drive(inst, { [q.AttrKey("T")] = {} }) end)
print("mock provider setAttr op, table value:", ok and "ACCEPTED" or ("rejected: " .. tostring(err)), "stored type:", typeof(mock.getAttributes(inst).T))
local ok2, err2 = pcall(function() q.Dispatch.drive(inst, { [q.AttrKey("bad name!")] = 1, [q.AttrKey("RBXx")] = 2, [q.AttrKey(string.rep("a", 101))] = 3 }) end)
print("invalid attribute names:", ok2 and "ACCEPTED" or ("rejected: " .. tostring(err2)))
local ok3, err3 = pcall(function() inst:SetAttribute("U", {}) end)
print("inst:SetAttribute table:", ok3 and "ACCEPTED" or ("rejected: " .. tostring(err3)))
local src = q.Source(1)
local inst2 = mock.Instance.new("Frame")
q.Dispatch.drive(inst2, { [q.AttrKey("S")] = src })
local ok4 = pcall(function() src:Set({ 1, 2 }) end)
print("State emits a table into AttrKey (mock provider):", ok4 and "ACCEPTED" or "rejected")
