+	-- PROTOTYPE (E1-2 Q74, scratch only): raise `_materializing` on the whole owner chain (Slot owners
+	-- up to the first non-Slot owner), restoring each saved value afterwards. Temp locals, no new fields.
+	local function raiseChain(self: any): ({ any }, { any })
+		local slots, olds = {}, {}
+		local cur = self
+		while cur ~= nil and S.isSlot(cur) do
+			slots[#slots + 1] = cur
+			olds[#olds + 1] = cur._materializing
+			cur._materializing = true
+			cur = S.elementOwner:GetWeak(cur, S.OWNER)
+		end
+		PATCH_RAW.attaches += 1
+		PATCH_RAW.chainTotal += #slots
+		return slots, olds
+	end
+	local function restoreChain(slots: { any }, olds: { any })
+		for k = #slots, 1, -1 do slots[k]._materializing = olds[k] end
+	end
