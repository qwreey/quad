--!nocheck
local H = require("./harness")
local q, D, None = H.q, H.D, H.None
local mock = require("../../../quad-base/test/mock")
local function try(label, f)
	local ok, r = pcall(f)
	print(label, ok and "ok" or "ERR", ok and tostring(r) or H.first(r))
end
try("tostring untyped", function() return tostring(q.Modifier{ZIndex=1}) end)
try("tostring typed table", function() return tostring(D.Modifier.Frame{ZIndex=1}) end)
try("tostring typed chain", function() return tostring(D.Modifier.Frame():ZIndex(1)) end)
try("tostring overridden", function() return tostring(D.Modifier.Frame{ZIndex=1}:Overridden(D.Modifier.Frame{})) end)
try("tag overridden", function() return (D.Modifier.Frame{ZIndex=1}:Overridden(D.Modifier.Frame{})).__quadModifier end)
try("typed ctor from sibling (TextButton->Frame)", function() return tostring(D.Modifier.Frame(D.Modifier.TextButton{TextSize=3})) end)
try("Merged exists?", function() return tostring(q.Modifier.Merged) end)
try("Merged method?", function() return tostring(rawget(getmetatable(q.Modifier()) , "x")) end)
try("mod.Merged is setter", function() local m = q.Modifier():Merged(3); return tostring(m:Peek("Merged")) end)
local s = q.Source(2)
try("state xform returns Ref", function() local m = q.Modifier{ZIndex=s}:ZIndex(function(o) return q.Ref() end); return tostring(m:Peek("ZIndex")) end)
try("state xform returns Ref -> mount", function() local m = q.Modifier{ZIndex=s}:ZIndex(function(o) return q.Ref() end); local f = D.Frame{m}; return tostring(f.ZIndex) end)
try("state xform throws", function() local m = q.Modifier{ZIndex=s}:ZIndex(function(o) error("boom") end); return tostring(m:Peek("ZIndex")) end)
try("plain xform throws", function() local m = q.Modifier{ZIndex=1}:ZIndex(function(o) error("boom") end); return tostring(m) end)
try("Alternative plain", function() local m = q.Modifier{ZIndex=1}:ZIndex(q.Operator.Alternative(5)); return tostring(m:Peek("ZIndex")) end)
try("Alternative nil", function() local m = q.Modifier():ZIndex(q.Operator.Alternative(5)); return tostring(m:Peek("ZIndex")) end)
local sn = q.Source(nil)
try("Alternative State", function() local m = q.Modifier{ZIndex=sn}:ZIndex(q.Operator.Alternative(5)); local v = m:Peek("ZIndex"); return tostring(v) .. " get=" .. tostring(v:Get()) end)
try("Alternative State mount", function() local m = q.Modifier{ZIndex=sn}:ZIndex(q.Operator.Alternative(5)); local f = D.Frame{m}; sn:Set(7); return tostring(f.ZIndex) end)
try("Tag as field", function() local m = q.Modifier{Name=q.Tag("a")}; local f = D.Frame{m}; return tostring(f.Name) end)
try("Attr as field", function() local m = q.Modifier{Name=q.Attr{a=1}}; local f = D.Frame{m}; return tostring(f.Name) end)
try("numeric key", function() return tostring(q.Modifier{[1]=D.Frame{}}) end)
try("state emits Modifier", function() local ss = q.Source(1); local m = q.Modifier{ZIndex=ss:Compute(function(h) return if h:Get()==2 then q.Modifier() else 1 end)}; local f = D.Frame{m}; ss:Set(2); return tostring(f.ZIndex) end)
