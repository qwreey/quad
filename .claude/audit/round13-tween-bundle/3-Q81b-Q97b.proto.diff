+	-- Q97 (b): does an engine-READ property value equal a quad-written target? The engine stores most numeric
+	-- properties as float32 (Transparency, Rotation, Vector2/Color3 components) and UDim Offset as an integer, so
+	-- `==` misses a value quad wrote itself. Only engine-read values go through this — record-vs-incoming target
+	-- stays exact `==` (Q25's value model). Types are read with `typeof` (the CLI seam shims it like `game`).
+	local REL = 1e-6
+	local function near(a: number, b: number): boolean
+		return math.abs(a - b) <= REL * math.max(1, math.abs(a), math.abs(b))
+	end
+	local function sameRead(read: any, target: any): boolean
+		if read == target then
+			return true
+		end
+		if not Q97_ON then
+			return false
+		end
+		local t = typeof(read)
+		if t ~= typeof(target) then
+			return false
+		end
+		if t == "number" then
+			return near(read, target)
+		elseif t == "UDim" then
+			return near(read.Scale, target.Scale) and math.abs(read.Offset - target.Offset) < 1
+		elseif t == "UDim2" then
+			return near(read.X.Scale, target.X.Scale) and math.abs(read.X.Offset - target.X.Offset) < 1
+				and near(read.Y.Scale, target.Y.Scale) and math.abs(read.Y.Offset - target.Y.Offset) < 1
+		elseif t == "Vector2" then
+			return near(read.X, target.X) and near(read.Y, target.Y)
+		elseif t == "Color3" then
+			return near(read.R, target.R) and near(read.G, target.G) and near(read.B, target.B)
+		end
+		return false
+	end
