diff --git a/quad-base/src/Dispatch/init.luau b/quad-base/src/Dispatch/init.luau
index 0c5585b..a791710 100644
--- a/quad-base/src/Dispatch/init.luau
+++ b/quad-base/src/Dispatch/init.luau
@@ -198,7 +198,11 @@ local function Init(module: any)
 		-- round11 `H-567` (탐사 G′ 6): a BASE brand (Slot/Ref/State…) can never be "provider not
 		-- initialized" — that hint only fits a provider brand or an unbranded value
 		local isBase = brand ~= nil and BASE_PROBE["is" .. brand] == true
-		local hint = if not isBase
+		-- P-Q90 proto (variant A — the draft table's order): an UNBRANDED value at a string key is
+		-- the everyday typo/read-only/other-class case — it used to fall into the provider arm
+		local hint = if brand == nil and type(k) == "string"
+			then " — not a writable property or event of this class (misspelled, read-only, or it belongs to another class?)"
+			elseif not isBase
 			then " — check that the provider for this value (e.g. quad-roblox) is initialized"
 			elseif brand == "Store" then " — a Store is not a value for any key: use one of its fields (store.Name) or wrap it (q.Attr(store))" -- 탐사 I′ 3
 			elseif type(k) == "string" then " — a quad value at a string key: it belongs in a numeric (array) slot"
