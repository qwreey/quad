diff --git a/quad-base/src/init.luau b/quad-base/src/init.luau
index abccd4f..fb256b7 100644
--- a/quad-base/src/init.luau
+++ b/quad-base/src/init.luau
@@ -214,7 +214,26 @@ local function New(): Quad
 		-- UseProvider 재호출은 계약 밖), 실행-전 표시는 providerFn이 도중
 		-- 던졌을 때 슬롯만 점유된 채 확장이 영영 병합되지 않는 좀비를
 		-- 만든다(재시도가 멱등 no-op로 삼켜짐).
-		local extension = providerFn(self)
+		-- Q108 (a) proto (`H-701`): a provider body calling `UseProvider` on the module it is
+		-- installing into merged both with only the outer one locked (B1) and a self call
+		-- recursed without bound (B2) — the slot is marked only after success (`H-307`), so a
+		-- per-module "installing" flag closes the window. Checked AFTER the idempotent/occupied
+		-- branches above: those answer first once a provider is locked.
+		if providerRelate:GetStrong(self, "installing") then
+			Err.errorBeforeNearest(
+				"QuadXXXX UseProvider: called while this module's provider is still installing — a provider must not call UseProvider on the module it is installing into (install extensions with AddPlugin)",
+				QuadTypes.ERROR_LEVEL_SURFACE
+			)
+		end
+		providerRelate:SetStrong(self, "installing", true)
+		-- the flag must not outlive a throwing provider (`Quad0228` retry path): run under pcall,
+		-- clear, then rethrow the original value untouched (level 0 — the message already carries
+		-- the blame prefix computed at the raise site)
+		local ok, extension = pcall(providerFn, self)
+		providerRelate:SetStrong(self, "installing", nil)
+		if not ok then
+			error(extension, 0) -- error-code: rethrow
+		end
 		mergeExtension(self, extension, "UseProvider")
 		providerRelate:SetStrong(self, "provider", providerFn)
 		return self :: any
