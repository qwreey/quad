---
// [2026-09-11 사용자] 헤더 로고 옆에 현재 버전 배지 — pesde 패키지 페이지로 링크. 기본 SiteTitle을 감싸기만 한다.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { QUAD_VERSION, PESDE_PACKAGE, PESDE_URL } from '../version';
---

<div class="site-title-with-version sl-flex">
	<Default />
	<a class="version-badge" href={PESDE_URL} title={`pesde: ${PESDE_PACKAGE} ${QUAD_VERSION}`} translate="no">v{QUAD_VERSION}</a>
</div>

<style>
	.site-title-with-version {
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}
	.version-badge {
		font-size: var(--sl-text-xs);
		font-weight: 600;
		line-height: 1;
		padding: 0.25rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
		background: var(--sl-color-gray-6);
		text-decoration: none;
		white-space: nowrap;
	}
	.version-badge:hover {
		color: var(--sl-color-text-accent);
		border-color: var(--sl-color-text-accent);
	}
</style>
