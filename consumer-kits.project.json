{
	"name": "quad-consumer-kits",
	"globIgnorePaths": ["quad-roblox-*/gallery/*.client.luau"],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"quad-base": {
				"$className": "Folder",
				"src": { "$path": "quad-base/src" },
				"luau_packages": { "$path": "quad-base/luau_packages" }
			},
			"quad-roblox": {
				"$className": "Folder",
				"src": { "$path": "quad-roblox/src" },
				"luau_packages": { "$path": "quad-roblox/luau_packages" }
			},
			"quad-roblox-devui": {
				"$className": "Folder",
				"src": { "$path": "quad-roblox-devui/src" },
				"gallery": { "$path": "quad-roblox-devui/gallery" },
				"stories": { "$path": "quad-roblox-devui/stories" }
			},
			"quad-roblox-material": {
				"$className": "Folder",
				"src": { "$path": "quad-roblox-material/src" },
				"gallery": { "$path": "quad-roblox-material/gallery" },
				"stories": { "$path": "quad-roblox-material/stories" }
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"DevuiDemo": { "$path": "quad-roblox-devui/gallery/DevuiDemo.client.luau" },
				"MaterialGallery": { "$path": "quad-roblox-material/gallery/MaterialGallery.client.luau" }
			}
		}
	}
}
