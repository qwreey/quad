--!strict
--[[
	quad-roblox typed surface — the type functions behind `q.Elem`/`q.Modifier`/`q.Spread`/`q.Mapper`/`q.OnChange`/
	`q.OnEvent`/`q.Out`/`q.ForClasses` (3.4.0 — `.claude/research/release-3.4.0-plan.md` 단위 2; design
	`.claude/research/declaration-surface-plan.md` 5절, names `.claude/research/declaration-naming-table.md` 5절).

	The CLASS types come from the checker the user runs (Studio / luau-lsp / CLI) — a class surface is whatever that
	checker declares, and checkers differ (2026-10-19 사용자 결정: documented, not absorbed). The DATA beside this file
	(`Data.luau`, generated by `scripts/gen-d.py emit`) only fills what no checker carries: the two class-name maps, the
	owner-keyed deny lists, engine-legacy members to inject, shorthand keys. Every rule is in `Build` below.

	`Build(mode, class, policy)` — one type function, many modes (each mode is one public or internal alias at the
	bottom). Grown from the probe `Lib5` (`.claude/audit/decl-typefn-probe-2026-10-16/src/Lib5.luau`); measured there:
	kit scale (330 files), the M1~M4 rounds, unit 0's large mixed file.
	⚠️ A type function has no pcall: a member whose type makes `parameters()`/`properties()` fail turns that class's
	whole surface into `never`. Deny such a member in `gen-d.py` and keep the surface gate green.

	Coexists with the generated `Declaration` until the 3.4.0 switch (plan unit 6) — nothing here is public yet.
]]

local QuadTypes = require("../luau_packages/quad_types")
local Types = require("./types")
local Data = require("@self/Data")

-- the policy the built-in surface reads (the two GUI-scope maps of `Data` name the classes `q.*` accept)
type Policy = {
	DenyIn: Data.DenyIn,
	DenyWriteIn: Data.DenyWriteIn,
	Inject: Data.Inject,
	Shorthand: Data.Shorthand,
	Child: Types.NewChild,
	Classes: Data.ModClassMap,
}
-- a Mapper's array part also admits nested mapper descriptors; `mapperctor` reads its key and result types here
type MapperPolicy = {
	DenyIn: Data.DenyIn,
	DenyWriteIn: Data.DenyWriteIn,
	Inject: Data.Inject,
	Shorthand: Data.Shorthand,
	Child: Types.NewChild | QuadTypes.MapperDescriptor,
	Classes: Data.ModClassMap,
	MapperKey: string | QuadTypes.MapperRoot,
	MapperResult: QuadTypes.MapperDescriptor,
}
-- `q.ForClasses<<M>>()`: the same data with the user's map as the class set (the `As<Desc>` down-cast tree walks it)
type PolicyFor<M> = {
	DenyIn: Data.DenyIn,
	DenyWriteIn: Data.DenyWriteIn,
	Inject: Data.Inject,
	Shorthand: Data.Shorthand,
	Child: Types.NewChild,
	Classes: M,
}
type MapperPolicyFor<M> = {
	DenyIn: Data.DenyIn,
	DenyWriteIn: Data.DenyWriteIn,
	Inject: Data.Inject,
	Shorthand: Data.Shorthand,
	Child: Types.NewChild | QuadTypes.MapperDescriptor,
	Classes: M,
	MapperKey: string | QuadTypes.MapperRoot,
	MapperResult: QuadTypes.MapperDescriptor,
}

export type function Build(mode: type, cls: type, policy: type)
	local M = mode:value()
	local NIL = types.singleton(nil)
	local TRUE = types.singleton(true)

	local function rotbl(fields: { [string]: type }): type
		local m: { [type]: { read: type?, write: type? } } = {}
		for k, v in fields do
			m[types.singleton(k)] = { read = v }
		end
		return types.newtable(m)
	end
	local function sub(t: type?, name: string): type?
		if t == nil or t.tag ~= "table" then
			return nil
		end
		for k, v in t:properties() do
			if k:value() == name then
				return v.read or v.write
			end
		end
		return nil
	end
	local function nameset(t: type?): { [string]: boolean }
		local s: { [string]: boolean } = {}
		if t ~= nil and t.tag == "table" then
			for k, _ in t:properties() do
				local n = k:value()
				if type(n) == "string" then
					s[n] = true
				end
			end
		end
		return s
	end
	local function callbackOf(ty: type): type?
		local conn: type? = nil
		if ty.tag == "table" then
			conn = ty:readproperty(types.singleton("Connect"))
		elseif ty.tag == "extern" then
			for k, v in ty:properties() do
				if k:value() == "Connect" then
					conn = v.read or v.write
					break
				end
			end
		end
		if conn ~= nil and conn.tag == "function" then
			local head = conn:parameters().head
			if head ~= nil and head[2] ~= nil then
				return head[2]
			end
		end
		return nil
	end
	local function chainOf(c: type): { type }
		local out = {}
		local cur: type? = c
		local d = 0
		while cur ~= nil and d < 16 do
			out[#out + 1] = cur
			cur = cur:readparent()
			d += 1
		end
		return out
	end
	local tweenable = {
		number = true, boolean = true, CFrame = true, Rect = true, Color3 = true,
		UDim = true, UDim2 = true, Vector2 = true, Vector2int16 = true, Vector3 = true,
	}
	local denyIn = sub(policy, "DenyIn")
	local denyWriteIn = sub(policy, "DenyWriteIn")
	local inject = sub(policy, "Inject")
	local shorthand = sub(policy, "Shorthand")
	local classesT = sub(policy, "Classes")

	type Info = { kind: string, ty: type, injected: boolean }
	local collectCache: { [string]: { any } } = {}
	local function collect(c: type, forRead: boolean): ({ string }, { [string]: Info }, { type })
		local ck = tostring(c) .. (if forRead then "/r" else "/w")
		local hit = collectCache[ck]
		if hit ~= nil then
			return hit[1], hit[2], hit[3]
		end
		local names: { string } = {}
		local info: { [string]: Info } = {}
		local chain = chainOf(c)
		local denyHere: { [string]: boolean } = {}
		for _, k in chain do
			local kn = tostring(k)
			for n in nameset(sub(denyIn, kn)) do
				denyHere[n] = true
			end
			if not forRead then
				for n in nameset(sub(denyWriteIn, kn)) do
					denyHere[n] = true
				end
			end
		end
		local function denied(n: string): boolean
			return denyHere[n] == true
		end
		for _, k in chain do
			for key, v in k:properties() do
				local n = key:value()
				if type(n) == "string" and info[n] == nil and not denied(n) then
					local ty = v.read or v.write
					if ty ~= nil and ty.tag ~= "function" and ty.tag ~= "intersection" then
						local cb = callbackOf(ty)
						if cb ~= nil then
							info[n] = { kind = "event", ty = cb, injected = false }
						else
							info[n] = { kind = "prop", ty = ty, injected = false }
						end
						names[#names + 1] = n
					end
				end
			end
		end
		for _, k in chain do
			local inj = sub(inject, tostring(k))
			if inj ~= nil and inj.tag == "table" then
				for key, v in inj:properties() do
					local n = key:value()
					local ty = v.read or v.write
					if type(n) == "string" and ty ~= nil and info[n] == nil and not denied(n) then
						info[n] = { kind = "prop", ty = ty, injected = true }
						names[#names + 1] = n
					end
				end
			end
			if not forRead then
				local sh = sub(shorthand, tostring(k))
				if sh ~= nil and sh.tag == "table" then
					for key, v in sh:properties() do
						local n = key:value()
						local ty = v.read or v.write
						if type(n) == "string" and ty ~= nil and info[n] == nil then
							info[n] = { kind = "shorthand", ty = ty, injected = true }
							names[#names + 1] = n
						end
					end
				end
			end
		end
		table.sort(names)
		collectCache[ck] = { names, info, chain }
		return names, info, chain
	end
	local function stateOf(t: type): type
		return rotbl({ __quadState = TRUE, __quadStateValue = t })
	end
	local NONE = rotbl({ __quadNone = TRUE })
	local function chainNames(chain: { type }): type
		local parts: { type } = {}
		for _, k in chain do
			parts[#parts + 1] = types.singleton(tostring(k))
			if tostring(k) == "Instance" then
				break
			end
		end
		if #parts == 1 then
			return parts[1]
		end
		return types.unionof(table.unpack(parts))
	end
	local function singletonUnion(list: { string }): type
		if #list == 0 then
			return types.never
		end
		local parts: { type } = {}
		for _, n in list do
			parts[#parts + 1] = types.singleton(n)
		end
		if #parts == 1 then
			return parts[1]
		end
		return types.unionof(table.unpack(parts))
	end
	local function elemOf(c: type): type
		local names, info, chain = collect(c, false)
		local events: { string } = {}
		for _, n in names do
			if info[n].kind == "event" then
				events[#events + 1] = n
			end
		end
		local rnames, rinfo = collect(c, true)
		local readable: { string } = {}
		for _, n in rnames do
			if rinfo[n].kind == "prop" then
				readable[#readable + 1] = n
			end
		end
		local tags = chainNames(chain)
		local child = sub(policy, "Child") or types.unknown
		local ev = rotbl({ __quadEvent = singletonUnion(events) })
		local ch = rotbl({ __quadChange = singletonUnion(readable) })
		-- [Lib4] the generated `<Class>RefMarker` (contravariant phantom: Ref<C?> and ancestor boxes pass, siblings fail)
		local ref = rotbl({ __quadRefAccepts = types.newfunction({ head = { c } }, { head = {} }) })
		return types.unionof(
			child,
			rotbl({ __quadModifier = tags }),
			rotbl({ __quadSpread = tags }),
			ev,
			ch,
			stateOf(types.unionof(ev, ch, NONE, NIL)),
			ref,
			stateOf(types.unionof(ref, NONE, NIL))
		)
	end
	-- value arms of a writable slot (props key / Modifier setter)
	local function slotArms(i: Info): type
		local arms: { type } = { i.ty }
		local tw: type? = nil
		if tweenable[tostring(i.ty)] then
			tw = rotbl({ __quadTween = TRUE, Value = i.ty })
			arms[#arms + 1] = tw :: type
		end
		-- [Lib4] the State arm carries the tween arm too (generated `PV` = StateMarker<T | Tween<T>>)
		local inner: type = if tw ~= nil then types.unionof(i.ty, tw) else i.ty
		if i.kind == "shorthand" then
			arms[#arms + 1] = stateOf(types.unionof(inner, NONE, NIL)) -- nil/None destroys the managed child
		else
			arms[#arms + 1] = stateOf(inner)
		end
		arms[#arms + 1] = NONE
		arms[#arms + 1] = NIL
		return types.unionof(table.unpack(arms))
	end
	-- classes of Policy.Classes whose chain contains c (c itself included when it is in the map)
	local function descendantsOf(c: type): { type }
		local out: { type } = {}
		local cn = tostring(c)
		if classesT ~= nil and classesT.tag == "table" then
			for _, v in classesT:properties() do
				local x = v.read or v.write
				local cur: type? = x
				local d = 0
				while cur ~= nil and d < 16 do
					if tostring(cur) == cn then
						out[#out + 1] = x :: type
						break
					end
					cur = cur:readparent()
					d += 1
				end
			end
		end
		return out
	end
	local modCache: { [string]: type } = {}
	local function modOf(c: type): type
		local key = tostring(c)
		local hit = modCache[key]
		if hit ~= nil then
			return hit
		end
		local names, info = collect(c, false)
		local t = types.newtable()
		modCache[key] = t
		t:setreadproperty(types.singleton("__quadModifier"), types.singleton(key))
		local T = types.generic("T")
		t:setproperty(types.singleton("Peek"),
			types.newfunction({ head = { t, types.string } }, { head = { types.unionof(T, NIL) } }, { T }))
		local U = types.generic("U")
		t:setproperty(types.singleton("Apply"),
			types.newfunction({ head = { types.any, types.newfunction({ head = { types.any } }, { head = { U } }) } },
				{ head = { U } }, { U }))
		t:setproperty(types.singleton("Overridden"),
			types.newfunction({ head = { t }, tail = types.any }, { head = { types.any } }))
		local AT = types.generic("T")
		t:setproperty(types.singleton("As"),
			types.newfunction({ head = { t, types.optional(types.string) } }, { head = { AT } }, { AT }))
		t:setproperty(types.singleton("As" .. key), types.newfunction({ head = { t } }, { head = { t } }))
		for _, d in descendantsOf(c) do
			if tostring(d) ~= key then
				t:setproperty(types.singleton("As" .. tostring(d)), types.newfunction({ head = { t } }, { head = { modOf(d) } }))
			end
		end
		for _, n in names do
			local i = info[n]
			if i.kind == "prop" or i.kind == "shorthand" then
				local v = slotArms(i)
				local transform = types.newfunction({ head = { types.unionof(i.ty, NIL) } }, { head = { v } })
				t:setproperty(types.singleton(n),
					types.newfunction({ head = { t, types.unionof(v, transform) } }, { head = { t } }))
			end
		end
		return t
	end

	-- props table of a class: write surface hash part (+ the element array part unless `hashOnly`)
	local function propsOf(c: type, hashOnly: boolean?): type
		local names, info = collect(c, false)
		local props: { [type]: { read: type?, write: type? } } = {}
		for _, n in names do
			local i = info[n]
			local u: type
			if i.kind == "event" then
				u = types.unionof(i.ty, stateOf(types.unionof(i.ty, NONE, NIL)), NONE, NIL)
			else
				u = slotArms(i)
			end
			props[types.singleton(n)] = { read = u, write = u }
		end
		if hashOnly then
			return types.newtable(props)
		end
		local elem = elemOf(c)
		return types.newtable(props, { index = types.number, readresult = elem, writeresult = elem })
	end
	-- `{ read <field>: "C" | <every ancestor of C> }` — the input-position marker (ModifierInto / SpreadInto). The whole
	-- chain, not the class map: a `q.ForClasses` map reaches classes the built-in GUI map does not name.
	local function intoOf(c: type, field: string): type
		return rotbl({ [field] = chainNames(chainOf(c)) })
	end
	-- the full Spread value: `{ read __quadSpread: "C", Append: (self, SpreadInto<C>) -> () }` (`:Append` returns nothing —
	-- a Spread is mutable; research/component-flatten-sugar-plan.md 5절 2026-10-20)
	local spreadCache: { [string]: type } = {}
	local function spreadOf(c: type): type
		local key = tostring(c)
		local hit = spreadCache[key]
		if hit ~= nil then
			return hit
		end
		local t = types.newtable()
		spreadCache[key] = t
		t:setreadproperty(types.singleton("__quadSpread"), types.singleton(key))
		t:setproperty(types.singleton("Append"), types.newfunction({ head = { t, intoOf(c, "__quadSpread") } }, { head = {} }))
		return t
	end

	-- [2026-10-20 3.4.0 단위 0] the *ctor modes return the WHOLE factory function type: the hoisting site
	-- (`local Frame = q.Elem "Frame"`) reduces it once and calls hit a plain function type. Returning `(Props<C>) -> C`
	-- with an unreduced `Props<…>` left one type-function constraint per call and a module of ~1500 calls hit
	-- Studio's `LuauSolverConstraintLimit` (audit/decl-typefn-probe-2026-10-16/REPORT.md, 단위 0 절).
	if M == "props" then
		return propsOf(cls)
	elseif M == "hashpart" then
		return propsOf(cls, true)
	elseif M == "elem" then
		return elemOf(cls)
	elseif M == "modifier" then
		return modOf(cls)
	elseif M == "intomarker" then
		return intoOf(cls, "__quadModifier")
	elseif M == "spreadinto" then
		return intoOf(cls, "__quadSpread")
	elseif M == "spread" then
		return spreadOf(cls)
	elseif M == "ctor" then
		return types.newfunction({ head = { propsOf(cls) } }, { head = { cls } })
	elseif M == "spreadctor" then
		return types.newfunction({ head = { propsOf(cls) } }, { head = { spreadOf(cls) } })
	elseif M == "modctor" then
		return types.newfunction({ tail = types.any }, { head = { modOf(cls) } })
	elseif M == "mapperctor" then
		-- `(key) -> (MapperProps<C>) -> MapperDescriptor` (policy = MapperPolicy: its Child admits nested descriptors)
		local key = sub(policy, "MapperKey") or types.string
		local result = sub(policy, "MapperResult") or types.any
		return types.newfunction({ head = { key } },
			{ head = { types.newfunction({ head = { propsOf(cls) } }, { head = { result } }) } })
	elseif M == "events" then
		local classes: { type } = {}
		if cls.tag == "union" then
			for _, c in cls:components() do
				classes[#classes + 1] = c
			end
		else
			classes = { cls }
		end
		local map: { [string]: type } = {}
		local order: { string } = {}
		for _, c in classes do
			local names, info = collect(c, false)
			for _, n in names do
				local i = info[n]
				if i.kind == "event" then
					local prev = map[n]
					if prev == nil then
						map[n] = i.ty
						order[#order + 1] = n
					elseif tostring(prev) ~= tostring(i.ty) then
						map[n] = types.any
					end
				end
			end
		end
		local props: { [type]: { read: type?, write: type? } } = {}
		for _, n in order do
			props[types.singleton(n)] = { read = map[n] }
		end
		return types.newtable(props)
	elseif M == "propmap" then
		-- WRITE surface name -> value type (ReadOnly denied)
		local names, info = collect(cls, false)
		local props: { [type]: { read: type?, write: type? } } = {}
		for _, n in names do
			local i = info[n]
			if i.kind == "prop" then
				props[types.singleton(n)] = { read = i.ty }
			end
		end
		return types.newtable(props)
	elseif M == "readmap" then
		-- READ surface (OnChange/Out): ReadOnly kept (forRead), Q127 (a) rule — Instance-class property reads as `T?`
		local function isInstance(t: type): boolean
			local cur: type? = t
			while cur ~= nil and cur.tag == "extern" do
				if tostring(cur) == "Instance" then
					return true
				end
				cur = cur:readparent()
			end
			return false
		end
		local names, info = collect(cls, true)
		local props: { [type]: { read: type?, write: type? } } = {}
		for _, n in names do
			local i = info[n]
			if i.kind == "prop" then
				local ty = i.ty
				if isInstance(ty) then
					ty = types.optional(ty)
				end
				props[types.singleton(n)] = { read = ty }
			end
		end
		return types.newtable(props)
	elseif M == "brief" then
		local list: { type } = if cls.tag == "union" then cls:components() else { cls }
		local out: { string } = {}
		for _, c in list do
			local names, info = collect(c, false)
			local np, ne, ns = 0, 0, 0
			for _, n in names do
				local k = info[n].kind
				if k == "event" then ne += 1 elseif k == "shorthand" then ns += 1 else np += 1 end
			end
			local rn, ri = collect(c, true)
			local nr = 0
			for _, n in rn do
				if ri[n].kind == "prop" then nr += 1 end
			end
			out[#out + 1] = tostring(c) .. " " .. np .. "/" .. ne .. "/" .. ns .. " r" .. nr
		end
		print("[BRIEF] " .. table.concat(out, "; "))
		return types.string
	end
	print("Build: unknown mode " .. tostring(M))
	return types.never
end


-- ── public aliases (3.4.0 names — research/declaration-naming-table.md 5절) ───────────────────────────────
export type Props<C> = Build<"props", C, Policy>
export type PropsHashPart<C> = Build<"hashpart", C, Policy>
export type PropsArrayItem<C> = Build<"elem", C, Policy>
export type MapperProps<C> = Build<"props", C, MapperPolicy>
export type Modifier<C> = Build<"modifier", C, Policy>
export type ModifierInto<C> = Build<"intomarker", C, Policy>
export type Spread<C> = Build<"spread", C, Policy>
export type SpreadInto<C> = Build<"spreadinto", C, Policy>
export type ElemCtor<C> = Build<"ctor", C, Policy>
export type PropertyMap<C> = Build<"propmap", C, Policy>
export type OnChangeDescriptor<K> = { read __quadChange: K }
export type OnEventDescriptor<K> = { read __quadEvent: K }

-- the curried value surface over a name map pair and a policy pair — the built-in one (GUI maps) and `q.ForClasses`
-- (the user's map for both) are this one type
export type Surface<CM, MM, P, MP> = {
	Elem: <K>(name: K & keyof<CM>) -> Build<"ctor", index<CM, K>, P>,
	Modifier: <K>(name: K & keyof<MM>) -> Build<"modctor", index<MM, K>, P>,
	Spread: <K>(name: K & keyof<MM>) -> Build<"spreadctor", index<MM, K>, P>,
	Mapper: <K>(name: K & keyof<CM>) -> Build<"mapperctor", index<CM, K>, MP>,
	OnChange: <C0>(class: C0 & keyof<MM>) -> <K>(name: K & keyof<Build<"readmap", index<MM, C0>, P>>)
		-> (fn: (index<Build<"readmap", index<MM, C0>, P>, K>) -> ()) -> OnChangeDescriptor<K>,
	OnEvent: <C0>(class: C0 & keyof<MM>) -> <K>(name: K & keyof<Build<"events", index<MM, C0>, P>>)
		-> (fn: index<Build<"events", index<MM, C0>, P>, K>) -> OnEventDescriptor<K>,
	Out: <C0>(class: C0 & keyof<MM>) -> <K>(name: K & keyof<Build<"readmap", index<MM, C0>, P>>)
		-> (src: QuadTypes.Source<index<Build<"readmap", index<MM, C0>, P>, K>>) -> OnChangeDescriptor<K>,
}
export type BuiltinSurface = Surface<Data.CreatableMap, Data.ModClassMap, Policy, MapperPolicy>
export type ForClasses = <M>() -> Surface<M, M, PolicyFor<M>, MapperPolicyFor<M>>

-- surface gate (scripts/test.sh): one line per class of both maps — counts, never a `never` surface
export type SurfaceBrief<C> = Build<"brief", C, Policy>

-- [2026-10-20 3.4.0] a custom Modifier class's setter value / stored value (the generated D's `Field<T>`/`FieldOut<T>`
-- under the decided names — declaration-naming-table 5절): literal | Tween | State marker | None | transform (old =
-- the stored value as-is). Not type functions — a kit writes them in its own Modifier type.
export type ModifierFieldOut<T> = Types.FieldOut<T>
export type ModifierField<T> =
	(T | Types.Tween<T> | QuadTypes.StateMarker<T | Types.Tween<T>> | QuadTypes.None)?
	| ((old: ModifierFieldOut<T>?) -> (T | Types.Tween<T> | QuadTypes.StateMarker<T | Types.Tween<T>> | QuadTypes.None)?)

return {}
