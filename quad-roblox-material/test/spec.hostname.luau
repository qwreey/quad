--!strict
-- Host Name rule (src/init.luau "API CONVENTIONS -> Hosts"): the host's default Name sits in the kit's base Modifier, so a
-- caller's `Modifier = q.Modifier "Class" ():Name("X")` renames it; without one the default name is unchanged.
local H = require("./support/harness")
local Q = require("../src/Quad")
local q = H.attach(Q)
q.debug = true
local Frame = q.Elem "Frame"
local Button = require("../src/Button")
local IconButton = require("../src/Button/IconButton")
local FAB = require("../src/Button/FAB")
local SplitButton = require("../src/Button/Split")
local ButtonGroup = require("../src/Button/Group")
local Checkbox = require("../src/Checkbox")
local Switch = require("../src/Switch")
local RadioModule = require("../src/Radio")
local Slider = require("../src/Slider")
local RangeSlider = require("../src/Slider/Range")
local M2 = require("../src/M2")
local TextField = require("../src/TextField")
local Select = require("../src/Select")
local Menu = require("../src/Menu")
local Card = require("../src/Card")
local Divider = require("../src/Divider")
local ListModule = require("../src/List")
local Tooltip = require("../src/Tooltip")
local Chip = require("../src/Chip")
local Tabs = require("../src/Tabs")
local Progress = require("../src/Progress")
local DatePicker = require("../src/DatePicker")
local ColorPicker = require("../src/ColorPicker")
local TimePicker = require("../src/TimePicker")
local BottomSheet = require("../src/BottomSheet")
local SideSheetModule = require("../src/SideSheet")
local Nav = require("../src/NavigationDrawer")
local ShortNavigationBar = require("../src/NavigationBar")
local Rail = require("../src/NavigationRail")
local BadgeModule = require("../src/Badge")
local AppBar = require("../src/AppBar")
local Toolbar = require("../src/Toolbar")
local ScaffoldModule = require("../src/Scaffold")

local Calendar = DatePicker.Calendar

-- ── controlled Checked form ─────────────────────────────────────────────────
H.section("every host: its default Name is unchanged, and the caller's Modifier :Name(...) overrides it", function()
	local checked = 0
	local function probe(label: string, default: string, build: (m: any) -> any)
		local plain = build(nil)
		assert(plain.Name == default, label .. ": default Name " .. tostring(plain.Name) .. " ~= " .. default)
		local class = plain.ClassName
		q.dispose(plain)
		local custom = "Custom_" .. label
		-- Card and ListItem take any GuiObject modifier (an `IntoGuiObject`, cast to the host class); the rest take the host class's
		local modClass = if string.find(label, "^Card") or string.find(label, "^ListItem") then "GuiObject" else class
		local mod = ((q.Modifier :: any)(modClass) :: any)():Name(custom)
		local host = build(mod)
		assert(host.Name == custom, label .. ": Modifier Name did not win (" .. tostring(host.Name) .. ")")
		checked += 1
		q.dispose(host)
	end
	local TODAY = Calendar.date(2026, 2, 10)
	probe("Button", "Button", function(m) return Button({ Label = "x", Modifier = m }) end)
	probe("IconButton", "IconButton", function(m) return IconButton({ Icon = "rbxassetid://1", Modifier = m }) end)
	probe("IconButton (TouchTarget)", "IconButton", function(m) return IconButton({ Icon = "rbxassetid://1", TouchTarget = true, Modifier = m }) end)
	probe("FAB", "FAB", function(m) return FAB({ Icon = "rbxassetid://1", Modifier = m }) end)
	probe("SplitButton", "SplitButton", function(m) return SplitButton({ Label = "x", Modifier = m }) end)
	probe("ButtonGroup", "ButtonGroup", function(m)
		return ButtonGroup({ Items = { { Key = "a", Label = "A" }, { Key = "b", Label = "B" } }, Value = q.Source(nil :: string?), Modifier = m })
	end)
	probe("Checkbox", "Checkbox", function(m) return Checkbox({ Modifier = m }) end)
	probe("Switch", "Switch", function(m) return Switch({ Modifier = m }) end)
	probe("Radio", "Radio", function(m) return RadioModule.Radio<<string>>({ Value = q.Source("a") :: any, Option = "a", Modifier = m }) end)
	probe("RadioGroup", "RadioGroup", function(m)
		return RadioModule.RadioGroup<<string>>({ Value = q.Source("a") :: any, Options = { { Option = "a", Label = "A" } }, Modifier = m })
	end)
	probe("Slider", "Slider", function(m) return Slider({ Modifier = m }) end)
	probe("RangeSlider", "RangeSlider", function(m) return RangeSlider({ Modifier = m }) end)
	probe("M2.Slider", "M2Slider", function(m) return M2.Slider({ Modifier = m }) end)
	probe("M2.RangeSlider", "M2RangeSlider", function(m) return M2.RangeSlider({ Modifier = m }) end)
	probe("M2.Switch", "M2Switch", function(m) return M2.Switch({ Modifier = m }) end)
	probe("TextField", "TextField", function(m) return TextField({ Label = "x", Modifier = m }) end)
	probe("Select", "TextField", function(m) return Select<<string>>({ Options = { "a" }, Value = q.Source(nil :: string?), Modifier = m }) end)
	probe("Menu.Button", "Button", function(m) return Menu.Button({ Label = "m", Items = { "divider" }, Modifier = m }) end)
	probe("Card", "Card", function(m) return Card({ Modifier = m }) end)
	probe("Card (interactive)", "Card", function(m) return Card({ OnClick = function() end, Modifier = m }) end)
	probe("Divider", "Divider", function(m) return Divider({ Modifier = m }) end)
	probe("Divider (inset)", "Divider", function(m) return Divider({ Inset = "Start", Modifier = m }) end)
	probe("List", "List", function(m) return ListModule.List({ Modifier = m }) end)
	probe("ListData", "List", function(m)
		return ListModule.ListData<<number>>({
			Items = q.Source({ 1 }),
			Key = function(n: number) return n end,
			Render = function(item: Q.State<number>) return Frame {} end,
			Modifier = m,
		})
	end)
	probe("ListItem", "ListItem", function(m) return ListModule.ListItem({ Headline = "x", Modifier = m }) end)
	probe("ListItem (interactive)", "ListItem", function(m) return ListModule.ListItem({ Headline = "x", OnClick = function() end, Modifier = m }) end)
	probe("Chip.Assist", "Chip", function(m) return Chip.Assist({ Label = "x", Modifier = m }) end)
	probe("Chip.Filter", "Chip", function(m) return Chip.Filter({ Label = "x", Selected = q.Source(false), Modifier = m }) end)
	probe("Chip.Input", "Chip", function(m) return Chip.Input({ Label = "x", Modifier = m }) end)
	probe("Chip.Suggestion", "Chip", function(m) return Chip.Suggestion({ Label = "x", Modifier = m }) end)
	probe("ChipSet", "ChipSet", function(m)
		return Chip.ChipSet<<number>>({
			Items = q.Source({ 1 }),
			Key = function(n: number) return n end,
			Render = function() return Frame {} end,
			Modifier = m,
		})
	end)
	probe("Tabs", "Tabs", function(m) return Tabs<<string>>({ Selected = q.Source("a"), Tabs = { { Key = "a", Label = "A" } }, Modifier = m }) end)
	probe("LinearProgress", "LinearProgress", function(m) return Progress.LinearProgress({ Value = 0.5, Modifier = m }) end)
	probe("LinearProgress (indeterminate)", "LinearProgress", function(m) return Progress.LinearProgress({ Modifier = m }) end)
	probe("CircularProgress", "CircularProgress", function(m) return Progress.CircularProgress({ Value = 0.5, Modifier = m }) end)
	probe("CircularProgress (indeterminate)", "CircularProgress", function(m) return Progress.CircularProgress({ Modifier = m }) end)
	probe("LoadingIndicator", "LoadingIndicator", function(m) return Progress.LoadingIndicator({ Modifier = m }) end)
	probe("WavyProgress", "WavyProgress", function(m) return Progress.WavyProgress({ Value = 0.5, Modifier = m }) end)
	probe("DatePicker.Docked", "DockedDatePicker", function(m) return DatePicker.Docked({ Value = q.Source(nil :: DatePicker.Date?), Today = TODAY, Modifier = m }) end)
	probe("DatePicker.RangeDocked", "DockedRangePicker", function(m)
		return DatePicker.RangeDocked({ Start = q.Source(nil :: DatePicker.Date?), End = q.Source(nil :: DatePicker.Date?), Today = TODAY, Modifier = m })
	end)
	probe("ColorPicker.Panel", "ColorPicker", function(m) return ColorPicker.Panel({ Modifier = m }) end)
	probe("Tooltip.Plain", "Tooltip", function(m) return Tooltip.Plain({ Text = "t", Modifier = m }) end)
	probe("TimePicker.Dial", "TimePickerDial", function(m) return TimePicker.Dial({ Value = q.Source(TimePicker.Clock.time(9, 0)), Modifier = m }) end)
	probe("TimePicker.Input", "TimePickerInput", function(m) return TimePicker.Input({ Value = q.Source(TimePicker.Clock.time(9, 0)), Modifier = m }) end)
	probe("BottomSheetScaffold", "BottomSheetScaffold", function(m) return BottomSheet.BottomSheetScaffold({ Modifier = m }) end)
	probe("SideSheet", "SideSheet", function(m) return SideSheetModule.SideSheet({ Modifier = m }) end)
	probe("ModalNavigationDrawer", "ModalNavigationDrawer", function(m) return Nav.ModalNavigationDrawer({ DrawerContent = Nav.ModalDrawerSheet(), Modifier = m }) end)
	probe("DismissibleNavigationDrawer", "DismissibleNavigationDrawer", function(m)
		return Nav.DismissibleNavigationDrawer({ DrawerContent = Nav.DismissibleDrawerSheet(), Modifier = m })
	end)
	probe("PermanentNavigationDrawer", "PermanentNavigationDrawer", function(m) return Nav.PermanentNavigationDrawer({ DrawerContent = Nav.PermanentDrawerSheet(), Modifier = m }) end)
	probe("ModalDrawerSheet", "ModalDrawerSheet", function(m) return Nav.ModalDrawerSheet({ Modifier = m }) end)
	probe("DismissibleDrawerSheet", "DismissibleDrawerSheet", function(m) return Nav.DismissibleDrawerSheet({ Modifier = m }) end)
	probe("PermanentDrawerSheet", "PermanentDrawerSheet", function(m) return Nav.PermanentDrawerSheet({ Modifier = m }) end)
	probe("NavigationDrawerItem", "NavigationDrawerItem", function(m) return Nav.NavigationDrawerItem({ Label = "x", Modifier = m }) end)
	probe("NavigationDrawerItems", "NavigationDrawerItems", function(m)
		return Nav.NavigationDrawerItems<<string>>({ Items = { { Key = "a", Label = "A" } }, Selected = q.Source("a"), Modifier = m })
	end)
	probe("NavigationDrawerHeadline", "NavigationDrawerHeadline", function(m) return Nav.NavigationDrawerHeadline({ Text = "x", Modifier = m }) end)
	probe("NavigationDrawerDivider", "NavigationDrawerDivider", function(m) return Nav.NavigationDrawerDivider({ Modifier = m }) end)
	local dests: { any } = { { Key = "a", Label = "A" } }
	probe("ShortNavigationBar", "ShortNavigationBar", function(m) return ShortNavigationBar<<string>>({ Items = dests, Selected = q.Source("a"), Modifier = m }) end)
	probe("WideNavigationRail", "WideNavigationRail", function(m) return Rail.WideNavigationRail<<string>>({ Items = dests, Selected = q.Source("a"), Modifier = m }) end)
	probe("Badge", "Badge", function(m) return BadgeModule.Badge({ Modifier = m }) end)
	probe("Badge (large)", "Badge", function(m) return BadgeModule.Badge({ Text = "1", Modifier = m }) end)
	probe("TopAppBar", "TopAppBar", function(m) return AppBar.TopAppBar({ Title = "x", Modifier = m }) end)
	probe("CenterAlignedTopAppBar", "CenterAlignedTopAppBar", function(m) return AppBar.CenterAlignedTopAppBar({ Title = "x", Modifier = m }) end)
	probe("MediumTopAppBar", "MediumTopAppBar", function(m) return AppBar.MediumTopAppBar({ Title = "x", Modifier = m }) end)
	probe("MediumFlexibleTopAppBar", "MediumFlexibleTopAppBar", function(m) return AppBar.MediumFlexibleTopAppBar({ Title = "x", Modifier = m }) end)
	probe("LargeTopAppBar", "LargeTopAppBar", function(m) return AppBar.LargeTopAppBar({ Title = "x", Modifier = m }) end)
	probe("LargeFlexibleTopAppBar", "LargeFlexibleTopAppBar", function(m) return AppBar.LargeFlexibleTopAppBar({ Title = "x", Modifier = m }) end)
	probe("BottomAppBar", "BottomAppBar", function(m) return AppBar.BottomAppBar({ Modifier = m }) end)
	probe("FlexibleBottomAppBar", "FlexibleBottomAppBar", function(m) return AppBar.FlexibleBottomAppBar({ Actions = {}, Modifier = m }) end)
	probe("HorizontalFloatingToolbar", "HorizontalFloatingToolbar", function(m) return Toolbar.HorizontalFloatingToolbar({ Expanded = true, Content = {}, Modifier = m }) end)
	probe("VerticalFloatingToolbar", "VerticalFloatingToolbar", function(m) return Toolbar.VerticalFloatingToolbar({ Expanded = true, Content = {}, Modifier = m }) end)
	probe("HorizontalFloatingToolbar (FAB)", "HorizontalFloatingToolbar", function(m)
		return Toolbar.HorizontalFloatingToolbar({ Expanded = true, Content = {}, FloatingActionButton = { Icon = "x" }, Modifier = m })
	end)
	probe("Scaffold", "Scaffold", function(m) return ScaffoldModule.Scaffold({ Content = Frame {}, Modifier = m }) end)
	assert(checked == 72, "probed " .. checked)
	H.assertNoDebugOutput("host names")
end)

H.done()
